						<Var>
							<Name>GVL_MD200_IO.nAO1_Raw</Name>
							<Comment><![CDATA[ MD200 physical process-image channels, staged for deliberate link review.
 ST-4424 Module 11 Channel AO1 (physical terminal 1, 0-10V).
 UINT 16 bit with 12-bit useful range 0..4095.]]></Comment>
							<Type>UINT</Type>
						</Var>
						<Var>
							<Name>GVL_MD200_IO.bRUN_DO</Name>
							<Comment><![CDATA[ Staged logical RUN: ST-2318 Module 10 immediately before AO module.
 DO0 is bit 0 of Output(s)^Byte 0; map ONLY one bit (not entire BYTE).
 WARNING: physical DO0/pin 0 must be confirmed unused and NPN wiring
 checked by the on-site technician BEFORE activating this configuration.
 All runtime software permits remain FALSE by default.]]></Comment>
							<Type>BOOL</Type>
						</Var>
