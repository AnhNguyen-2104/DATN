                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                          <TextBlock Text="Host NIC IP (PC Network Adapter IPv4)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2HostIpBox" FontSize="11" TextChanged="SettingsS2NicTextChanged" ToolTip="Host NIC IPv4 on the Station 02 camera subnet."/>
                        </StackPanel>
                      </Grid>
                      <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="SettingsS2ConnectButton" Content="CONNECT" Click="SettingsS2ConnectCamera_Click" MinHeight="28" Padding="14,3" Background="#1B4D3E" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" ToolTip="Connect directly to entered Camera 2 IP and Host NIC."/>
                        <Button x:Name="SettingsS2DisconnectButton" Content="DISCONNECT" Click="SettingsS2DisconnectCamera_Click" MinHeight="28" Padding="14,3" Background="#4A1E24" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" ToolTip="Disconnect Station 02 camera."/>
                        <Button x:Name="SettingsS2SaveButton" Content="SAVE CONFIG" Click="SettingsS2Save_Click" MinHeight="28" Padding="12,3" Background="#162C42" Foreground="White" Margin="0,0,8,0" ToolTip="Persist Camera 2 IP and Host NIC settings to slot configuration."/>
                        <Button x:Name="SettingsS2ScanButton" Content="SCAN (OPTIONAL)" Click="SettingsS2Scan_Click" MinHeight="28" Padding="10,3" Background="#162C42" Foreground="#92AABE" ToolTip="Optional diagnostic GVCP scan. Direct IP CONNECT does not require SCAN."/>
                      </WrapPanel>
                      <TextBlock Text="Settings persist to local slot profile (camera_slots.json). Station 02 is reserved: camera preview only, no robot motion commands." FontSize="9" Foreground="#92AABE" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#112335" BorderBrush="#23384D" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel>
                      <TextBlock Text="STATION 02 · NOT COMMISSIONED" FontSize="12" FontWeight="Bold" Foreground="#E3D3A0"/>
                      <TextBlock Text="SCARA robot remains uncommissioned with no validated PLC symbols; robot controls are disabled. Camera 02 Hikrobot GigE manual IP connection is configurable above for camera preview." FontSize="10" Foreground="#B9CBD8" TextWrapping="Wrap" Margin="0,5,0,10"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Robot controller" FontSize="10" Foreground="#92AABE" Margin="0,0,0,4"/>
                        <TextBlock Grid.Column="1" Text="UNMAPPED · no validated PLC symbols" FontSize="10" Foreground="#E3D3A0" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Text="Camera 02 source" FontSize="10" Foreground="#92AABE" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SettingsS2CamSourceSummary" Text="Hikrobot GigE · configured above" FontSize="10" Foreground="#27C9EC" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Text="Vision calibration / ROI" FontSize="10" Foreground="#92AABE" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SettingsS2CalibSummary" Text="NOT CONFIGURED (FAIL CLOSED)" FontSize="10" Foreground="#E3D3A0" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="3" Text="Tray recipe" FontSize="10" Foreground="#92AABE" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SettingsS2TraySummary" Text="NOT CONFIGURED (FAIL CLOSED)" FontSize="10" Foreground="#E3D3A0" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="4" Text="Robot access level" FontSize="10" Foreground="#92AABE"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="NO COMMANDS PERMITTED" FontSize="10" Foreground="#FF6E70"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <!-- OFFLINE CALIBRATION & TRAY ALLOCATOR CONFIGURATION -->
                  <Border Background="#112335" BorderBrush="#23384D" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock Text="OFFLINE CALIBRATION &amp; TRAY ALLOCATOR (PURE SIMULATION · NO ROBOT COMMANDS)" FontSize="11" FontWeight="Bold" Foreground="#27C9EC"/>
                      <TextBlock Text="Explicit offline calibration and tray parameters. All values must be supplied explicitly. Non-finite or missing values fail closed. No default 3x4 layout; no auto-advance; zero PLC writes." FontSize="9.5" Foreground="#B9CBD8" TextWrapping="Wrap" Margin="0,4,0,8"/>
                      
                      <!-- Calibration parameters -->
