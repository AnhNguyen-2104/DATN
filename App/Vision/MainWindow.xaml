                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#142330" BorderBrush="#33485C" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="02 / SCARA PICK &amp; PLACE" Foreground="#B0C1D0" FontSize="11" FontWeight="Bold"/><TextBlock Text="Gắp sản phẩm vào khay" Foreground="#E6EFF5" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
