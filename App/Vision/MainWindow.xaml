                      </WrapPanel>
                      <TextBlock Text="Changing direction or position resets tracking to avoid false triggers. Default product: 50 × 50 mm, four dots at 40 × 40 mm pitch." FontSize="9" Foreground="#92AABE" TextWrapping="Wrap" Margin="0,8,0,0"/>
