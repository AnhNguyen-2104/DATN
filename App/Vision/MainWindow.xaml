                        <Button x:Name="SettingsS1DisconnectButton" Content="DISCONNECT" Click="SettingsS1DisconnectCamera_Click" MinHeight="28" Padding="14,3" Background="#4A1E24" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" ToolTip="Disconnect Station 01 Basler USB camera."/>
                        <Button x:Name="SettingsS1SaveButton" Content="SAVE CONFIG" Click="SettingsS1Save_Click" MinHeight="28" Padding="12,3" Background="#162C42" Foreground="White" Margin="0,0,8,0" ToolTip="Persist Camera 1 configuration to slot profile."/>
                        <Button x:Name="SettingsS1ScanButton" Content="SCAN USB" Click="SettingsS1Scan_Click" MinHeight="28" Padding="10,3" Background="#162C42" Foreground="White" ToolTip="Enumerate connected Basler USB cameras via pylon SDK."/>
                      </WrapPanel>
                      <TextBlock Text="Settings persist to local slot profile (camera_slots.json). Station 01 Basler connects through pylon SDK USB device scan (no IP/NIC)." FontSize="9" Foreground="#92AABE" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#112335" BorderBrush="#23384D" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel>
                      <TextBlock Text="DETECTION / TRIGGER · STATION 01" FontSize="12" FontWeight="Bold" Foreground="#27C9EC"/>
                      <TextBlock Text="Track objects before they cross the reference line. Each Track ID triggers once. Only image processing is affected." FontSize="10" Foreground="#B9CBD8" TextWrapping="Wrap" Margin="0,5,0,9"/>
                      <WrapPanel>
                        <TextBlock Text="Conveyor direction" VerticalAlignment="Center" FontSize="10" Foreground="#92AABE" Margin="0,0,7,0"/>
                        <ComboBox x:Name="LineDirectionPicker" SelectionChanged="LineDirection_Changed" Width="170" FontSize="11">
                          <ComboBoxItem Content="X →" />
                          <ComboBoxItem Content="X ←" />
                          <ComboBoxItem Content="Y ↓" />
                          <ComboBoxItem Content="Y ↑" IsSelected="True" />
                        </ComboBox>
                        <TextBlock Text="Position (% FOV)" VerticalAlignment="Center" FontSize="10" Foreground="#92AABE" Margin="10,0,7,0"/>
                        <TextBox x:Name="LineFractionBox" Text="50" Width="80" FontSize="11"/>
                        <Button Content="APPLY" Click="ApplyLine_Click" MinHeight="28" Padding="10,3" Background="#162C42" Foreground="White"/>
                      </WrapPanel>
                      <TextBlock Text="Changing direction or position resets tracking to avoid false triggers. Default product: 50 × 50 mm, four dots at 40 × 40 mm pitch." FontSize="9" Foreground="#92AABE" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#112335" BorderBrush="#23384D" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock Text="VISION CALIBRATION / ROI" FontSize="12" FontWeight="Bold" Foreground="#27C9EC"/>
                      <TextBlock Text="Maps image pixels to conveyor millimetres. Demo calibration must never drive a real robot." FontSize="10" Foreground="#B9CBD8" TextWrapping="Wrap" Margin="0,5,0,9"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="mm per pixel (0 = geometric estimate)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="ScaleBox" Text="0" FontSize="11"/>
                          <TextBlock Text="Threshold mode" Style="{StaticResource FieldLabel}"/>
                          <ComboBox x:Name="ThresholdPicker" FontSize="11">
                            <ComboBoxItem Content="AUTO" IsSelected="True" />
                            <ComboBoxItem Content="DARK PRODUCT" />
                            <ComboBoxItem Content="BRIGHT PRODUCT" />
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                          <TextBlock Text="Origin X (px)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="OriginXBox" Text="Auto" FontSize="11"/>
                          <TextBlock Text="Origin Y (px)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="OriginYBox" Text="Auto" FontSize="11"/>
                        </StackPanel>
                      </Grid>
                      <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Offset X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="OffsetXBox" Text="0" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                          <TextBlock Text="Offset Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="OffsetYBox" Text="0" FontSize="11"/>
                        </StackPanel>
                      </Grid>
                      <Button Content="APPLY CALIBRATION" Click="ApplyCalibration_Click" MinHeight="28" Padding="10,3" HorizontalAlignment="Left" Background="#162C42" Foreground="White" Margin="2,6,0,0"/>
                      <CheckBox x:Name="EnableWriteBox" Visibility="Collapsed" Foreground="#F4BB45" Content="I explicitly approve manual X/Y/θ writes" />
                      <Button Visibility="Collapsed" Content="TEST X/Y/θ WRITE (no trigger)" Click="WritePose_Click" MinHeight="28" Foreground="White" />
                      <TextBlock Text="Calibration is stored locally. PLC coordinate delivery requires a separately authorized supervised FIFO bench; direct ADS writes remain disabled." FontSize="9" Foreground="#F4BB45" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#112335" BorderBrush="#23384D" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock Text="OFFLINE PIPELINE BENCH · NO ROBOT MOTION" FontSize="12" FontWeight="Bold" Foreground="#27C9EC"/>
                      <TextBlock Text="Validates X/Y, rotation, FIFO and four glue points in a simulator. No ADS writes to the live PLC." FontSize="10" Foreground="#B9CBD8" TextWrapping="Wrap" Margin="0,5,0,8"/>
                      <CheckBox x:Name="OfflinePipelineBox" Content="Enable simulated FIFO triggers during detection (no PLC commands)" Foreground="#DCE8F0" IsChecked="False" FontSize="10" Checked="OfflinePipelineChanged" Unchecked="OfflinePipelineChanged" Margin="0,0,0,6"/>
                      <CheckBox x:Name="BenchQueueBox" Foreground="#DCE8F0" Content="Send video pose → TwinCAT FIFO bench (no robot motion)" FontSize="10" Checked="BenchQueue_Click" Unchecked="BenchQueue_Click" Margin="0,0,0,6"/>
                      <WrapPanel>
                        <Button Content="RUN OFFLINE 4-POINT / ACK / ENCODER TEST" Click="TestOfflinePipeline_Click" MinHeight="28" Padding="10,3" Background="#162C42" Foreground="White"/>
                        <Button x:Name="SendPausedVideoFrameButton" Content="SEND ONE PAUSED VIDEO FRAME" Click="SendPausedVideoFrame_Click" MinHeight="28" Padding="10,3" Background="#162C42" Foreground="White"/>
                      </WrapPanel>
                      <TextBlock x:Name="PipelineMockStatus" Text="Simulation not started; TwinCAT ADS remains read-only." TextWrapping="Wrap" FontSize="9" Foreground="#92AABE" Margin="2,7,0,0"/>
                      <TextBlock Text="Requires bQueueSimMode, motion disabled, calibrated mm/px and operator approval." FontSize="9" Foreground="#F4BB45" TextWrapping="Wrap" Margin="2,4,0,0"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <!-- STATION 02 -->
            <TabItem Header="STATION 02 / SCARA" x:Name="SettingsStation2Tab">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                <StackPanel HorizontalAlignment="Stretch">
                  <!-- HIKROBOT GigE CAMERA 2 -->
                  <Border Background="#112335" BorderBrush="#23384D" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
