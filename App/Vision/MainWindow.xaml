                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                          <TextBlock Text="Scale (mm/px)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2ScaleBox" Text="" FontSize="11" ToolTip="Explicit positive mm/pixel scale. Blank fails closed."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                          <TextBlock Text="Origin X (px)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2OriginXBox" Text="" FontSize="11" ToolTip="Explicit finite Origin X in pixels. Blank fails closed."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                          <TextBlock Text="Origin Y (px)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2OriginYBox" Text="" FontSize="11" ToolTip="Explicit finite Origin Y in pixels. Blank fails closed."/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="Offset X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2OffsetXBox" Text="" FontSize="11" ToolTip="Explicit finite Offset X in mm. Blank fails closed."/>
                        </StackPanel>
                      </Grid>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                          <TextBlock Text="Offset Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2OffsetYBox" Text="" FontSize="11" ToolTip="Explicit finite Offset Y in mm. Blank fails closed."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                          <TextBlock Text="Hole Pitch (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2HolePitchBox" Text="" FontSize="11" ToolTip="Explicit strictly positive hole pitch in mm (e.g. 40.0). Blank fails closed."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                          <TextBlock Text="Plate Size (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2PlateSizeBox" Text="" FontSize="11" ToolTip="Explicit strictly positive plate size in mm (e.g. 50.0). Blank fails closed."/>
                        </StackPanel>
                        <StackPanel Grid.Column="3"/>
                      </Grid>

                      <!-- Tray parameters -->
                      <TextBlock Text="OFFLINE TRAY LAYOUT (NO IMPLICIT DEFAULTS)" FontSize="10" FontWeight="Bold" Foreground="#DCE8F0" Margin="0,4,0,4"/>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                          <TextBlock Text="Rows (>0)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayRowsBox" Text="" FontSize="11" ToolTip="Explicit positive row count (no default 3x4)."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                          <TextBlock Text="Columns (>0)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayColsBox" Text="" FontSize="11" ToolTip="Explicit positive column count."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                          <TextBlock Text="Pitch X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayPitchXBox" Text="" FontSize="11" ToolTip="Explicit positive column pitch."/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="Pitch Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayPitchYBox" Text="" FontSize="11" ToolTip="Explicit positive row pitch."/>
                        </StackPanel>
                      </Grid>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                          <TextBlock Text="Origin X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayOriginXBox" Text="" FontSize="11" ToolTip="Explicit finite tray origin X in mm."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                          <TextBlock Text="Origin Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayOriginYBox" Text="" FontSize="11" ToolTip="Explicit finite tray origin Y in mm."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                          <TextBlock Text="Tray Angle (°)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayAngleBox" Text="" FontSize="11" ToolTip="Explicit finite tray angle in degrees."/>
                        </StackPanel>
                        <StackPanel Grid.Column="3"/>
                      </Grid>

