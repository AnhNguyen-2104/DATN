    <SolidColorBrush x:Key="VDThemeComboFg" Color="#E8F1FC" />
  </Window.Resources>
    <Grid Background="{StaticResource ScadaBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="43" />
      <RowDefinition Height="*" />
      <RowDefinition Height="20" />
    </Grid.RowDefinitions>

    <!-- Top bar: brand + global read-only status. Approved compact density. -->
    <Border Grid.Row="0" Background="{StaticResource ScadaTopBg}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,1" Padding="12,0">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="DATN" FontSize="19" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center" />
        <Border Grid.Column="1" Width="1" Height="21" Background="{StaticResource ScadaBorder}" Margin="13,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="LINE CONTROL SCADA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ShellAdsDot" Width="6" Height="6" Fill="{StaticResource ScadaAmber}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock x:Name="ControlSafetyBanner" Text="PRODUCTION AUTO: DISARMED · COMMISSIONING PENDING" Foreground="{StaticResource ScadaTextSecondary}" FontSize="10" VerticalAlignment="Center"/>
          <CheckBox x:Name="DarkModeBox" Content="Theme" IsChecked="True" Visibility="Collapsed" Checked="DarkModeChanged" Unchecked="DarkModeChanged" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Horizontal tab navigation replaces the old 170px sidebar to reclaim page width. -->
    <Border Grid.Row="1" Background="{StaticResource ScadaNavBg}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,0" Padding="5,0,0,0">
      <TabControl x:Name="MainNavigation" TabStripPlacement="Top" Background="Transparent" BorderThickness="0" Margin="0" Padding="0" SelectedIndex="0" SelectionChanged="MainNavigation_SelectionChanged">
        <TabControl.Resources>
          <Style TargetType="TabItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ScadaTextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                  <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="13,0">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource ScadaPanelHover}" />
                      <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource ScadaBorderBright}" />
                      <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}" />
                    </Trigger>
                    <MultiTrigger>
                      <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsSelected" Value="False" />
                      </MultiTrigger.Conditions>
                      <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource ScadaPanelPrimary}" />
                      <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}" />
                    </MultiTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </TabControl.Resources>
      <!-- LARGE_CAMERA_OVERVIEW_V2: camera+station I/O dominate the first screen. -->
      <TabItem Header="LINE OVERVIEW" x:Name="DashboardTab">
        <Grid Background="{StaticResource ScadaBg}" Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Two cameras share the width 50/50 and take all remaining vertical space. -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="29"/>
                  <RowDefinition Height="*" MinHeight="80"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource ScadaPanelHead}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,1" Padding="8,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="CAM 1 · GANTRY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="Ov1CamStatus" Text="OFFLINE" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Grid.Column="2" x:Name="Ov1BadgeHost" Background="{StaticResource ScadaPanelSecondary}" CornerRadius="2" Padding="6,1" VerticalAlignment="Center">
                      <TextBlock x:Name="Ov1Badge" Text="CHECKING" Foreground="{StaticResource ScadaTeal}" FontSize="9" FontWeight="Bold"/>
                    </Border>
                  </Grid>
                </Border>
                <Grid Grid.Row="1" Background="{StaticResource ScadaVideoBg}">
                  <Image x:Name="Ov1CamImage" Source="{Binding Source,ElementName=Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock x:Name="Ov1CamEmpty" Text="CAM 1 OFFLINE · NO FRAME" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ScadaTextSecondary}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
                </Grid>
                <UniformGrid Grid.Row="2" Columns="4" Background="{StaticResource ScadaPanelSecondary}">
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="TRACK ID" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="Ov1Track" Text="--" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="GANTRY / PLC-Q" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="Ov1Link" Text="NO DATA" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="PRODUCT X / Y" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="Ov1Pose" Text="-- / -- mm" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="GANTRY MODE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="Ov1Mode" Text="NO DATA" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                </UniformGrid>
              </Grid>
            </Border>

            <Rectangle Grid.Column="1" Fill="{StaticResource ScadaBorder}"/>

            <Border Grid.Column="2" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="29"/>
                  <RowDefinition Height="*" MinHeight="80"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource ScadaPanelHead}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,1" Padding="8,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="CAM 2 · SCARA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="Ov2CamStatus" Text="OFFLINE" FontSize="10" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Grid Grid.Row="1" Background="{StaticResource ScadaVideoBg}">
                  <Image x:Name="Ov2CamImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <StackPanel x:Name="Ov2CamEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="NO SIGNAL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="CAM 2 OFFLINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="SCARA not commissioned" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
                <UniformGrid Grid.Row="2" Columns="4" Background="{StaticResource ScadaPanelSecondary}">
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="TRACK ID" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock Text="--" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="TRACKING" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock Text="UNAVAILABLE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="PRODUCT X / Y" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock Text="-- / -- mm" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="SCARA ROBOT" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock Text="NOT COMM." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                </UniformGrid>
              </Grid>
            </Border>
          </Grid>

          <!-- Shared conveyor telemetry + machine commands, one compact strip under both cameras. -->
          <Border Grid.Row="1" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" Margin="0,5,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Background="{StaticResource ScadaPanelHead}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,1" Padding="8,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="CONVEYOR + COMMANDS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
                    <Button x:Name="OpenCalibrationWorkspaceBtn" Content="CALIBRATION WORKSPACE" Click="OpenCalibrationWorkspace_Click" MinHeight="22" Padding="8,1" FontSize="9.5" Background="#162C42" Foreground="{StaticResource ScadaCyan}" BorderBrush="{StaticResource ScadaCyan}" BorderThickness="1" Margin="8,0,0,0" ToolTip="Opens the integrated Calibration Workspace (Video OpenCV overlay &amp; Gantry 4-corner preview)."/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CONVEYOR SUBSYSTEM MODE (LIVE MD200):" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="LineModeSelector" SelectionChanged="LineMode_Changed" Width="260" MinHeight="22" FontSize="9.5" VerticalAlignment="Center">
                      <ComboBoxItem Content="PRODUCTION AUTO (LINE) · COMMISSIONING PENDING" IsSelected="True"/>
                      <ComboBoxItem Content="CONVEYOR SUBSYSTEM CALIBRATION · ISOLATED"/>
                    </ComboBox>
                    <Border x:Name="CalibrationBadge" Visibility="Collapsed" Background="#162C42" BorderBrush="#27C9EC" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="8,0,0,0">
                      <TextBlock Text="CONVEYOR SUBSYSTEM CALIBRATION · ISOLATED BELT RUN (NO ROBOT/GLUE)" FontSize="8.5" FontWeight="Bold" Foreground="#27C9EC"/>
                    </Border>
                    <CheckBox x:Name="OvCalibrationArm" Content="Arm Subsystem Calibration" Visibility="Collapsed" Checked="CalibrationArm_Changed" Unchecked="CalibrationArm_Changed" Foreground="#F4BB45" FontSize="9.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="OvUpdated" Text="Reading PLC..." FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="OvContractStatus" Text="CONTRACT PENDING" FontSize="9" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>

              <UniformGrid Grid.Row="1" Columns="4" Background="{StaticResource ScadaPanelSecondary}">
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="RUN" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvRun" Text="NO DATA" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="ACTUAL (mm/s)" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvSpeed" Text="-- mm/s" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="POSITION (mm)" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvDistance" Text="-- mm" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="MODE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvCommand" Text="DISARMED" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
              </UniformGrid>

              <StackPanel Grid.Row="2" Margin="8,5,8,4">
                <WrapPanel VerticalAlignment="Center">
                  <TextBlock Text="SPEED (mm/s)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox x:Name="OvPresetSpeedBox" Text="100" Width="64" MinHeight="25" Padding="5,1" FontSize="11" HorizontalContentAlignment="Right" LostFocus="PresetSpeed_LostFocus" ToolTip="Shared speed preset in mm/s [1.0..150.0]. Applied to conveyor calibration setpoint."/>
                  <Button x:Name="OvPresetApplyButton" Content="APPLY" Click="PresetSpeedApply_Click" MinWidth="50" MinHeight="25" Padding="6,1" FontSize="10" Margin="6,0,0,0" ToolTip="Applies preset speed to TwinCAT MD200 manual mailbox via ADS."/>
                  <Rectangle Width="1" Height="20" Fill="{StaticResource ScadaBorder}" Margin="10,0"/>
                  <Button x:Name="SysStartButton" Content="START" Click="SysLineStart_Click" IsEnabled="False" MinWidth="62" MinHeight="25" Padding="8,1" FontSize="11" ToolTip="One operator START: PC vision tracking and the conveyor request go together. Disabled while any prerequisite is unknown, stale or uncommissioned."/>
                  <Button x:Name="SysStopButton" Content="STOP" Click="SysLineStop_Click" IsEnabled="False" MinWidth="58" MinHeight="25" Padding="6,1" FontSize="11" Margin="4,0,0,0" ToolTip="Requests the normal coordinated stop (tracking + conveyor request). NOT a certified emergency stop."/>
                  <Button x:Name="SysResetButton" Content="RESET" Click="SysLineReset_Click" IsEnabled="False" MinWidth="58" MinHeight="25" Padding="6,1" FontSize="11" Margin="4,0,0,0" ToolTip="Clears the HMI stop latch only after a stop request or fault. It never resets a physical drive or robot fault."/>
                  <Rectangle Width="1" Height="20" Fill="{StaticResource ScadaBorder}" Margin="10,0"/>
                  <Button x:Name="OvVisionStartButton" Content="VISION START" Click="StationVisionStart_Click" MinWidth="90" MinHeight="25" Padding="6,1" FontSize="9.5" ToolTip="PC-only detection. Does not start the conveyor and is not a line START."/>
                  <Button x:Name="OvVisionStopButton" Content="VISION STOP" Click="StationVisionStop_Click" MinWidth="86" MinHeight="25" Padding="6,1" FontSize="9.5" Margin="4,0,0,0" ToolTip="Stops detection only; camera view remains live. NOT a machine stop."/>
                </WrapPanel>
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <UniformGrid Grid.Column="0" Columns="4">
                    <TextBlock x:Name="OvIlAds" Text="○ ADS 851" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlEstop" Text="○ E-STOP AUX" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlPlcQ" Text="○ PLC-Q LINK" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlGantry" Text="○ GANTRY FAULT" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlCamera" Text="○ CAM 1 FRAME" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlSpeed" Text="○ SPEED PRESET" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlMaster" Text="○ AUTO CONTRACT" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlScara" Text="○ STATION 02 EXCLUDED" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                  </UniformGrid>
                  <TextBlock Grid.Column="1" x:Name="OvStartReason" Text="NOT EVALUATED" FontSize="9" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" MaxWidth="420" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <TextBlock x:Name="OvPresetHz" Text="Hz: NOT CALIBRATED" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="OvPresetError" Text="" FontSize="9" Foreground="{StaticResource ScadaRed}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
              </StackPanel>

              <Border Grid.Row="3" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,1,0,0" Padding="8,3">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="OvCvQuality" Text="NO DATA" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" x:Name="OvAlarm" Text="No PLC alarm data." FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" x:Name="OvCommandCommissionStatus" Text="PRODUCTION AUTO · COMMISSIONING PENDING" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- Legacy dashboard data sinks: unchanged writers, never shown. -->
          <StackPanel Grid.Row="2" Visibility="Collapsed">
            <TextBlock x:Name="DashUpdated"/>
            <TextBlock x:Name="OverviewGlobalAuthority"/>
            <Image x:Name="OverviewCam1Image" Source="{Binding Source,ElementName=Preview}"/>
            <TextBlock x:Name="OverviewCam1Quality"/>
            <TextBlock x:Name="OverviewCam1Empty"/>
            <TextBlock x:Name="OverviewIoEstop"/>
            <TextBlock x:Name="OverviewIoPlcQ"/>
            <TextBlock x:Name="OverviewIoGantryBusy"/>
            <TextBlock x:Name="OverviewIoGantryAlarm"/>
            <TextBlock x:Name="OverviewIoVision"/>
            <TextBlock x:Name="OverviewIoBeltDO"/>
            <TextBlock x:Name="OverviewIoMd200Cmd"/>
            <TextBlock x:Name="OverviewIoEncoder"/>
            <TextBlock x:Name="OverviewIoAo"/>
            <TextBlock x:Name="OverviewCam1Track"/>
            <TextBlock x:Name="OverviewCam1Pose"/>
            <TextBlock x:Name="DashSpeed"/>
            <TextBlock x:Name="DashBeltState"/>
            <TextBlock x:Name="DashDistance"/>
            <TextBlock x:Name="DashBeltMmS"/>
            <TextBlock x:Name="Ov1Ready"/>
            <TextBlock x:Name="Ov1Busy"/>
            <TextBlock x:Name="Ov1Homed"/>
            <TextBlock x:Name="Ov1X"/>
            <TextBlock x:Name="Ov1Y"/>
            <TextBlock x:Name="Ov1Z"/>
            <TextBlock x:Name="Ov1Rz"/>
            <TextBlock x:Name="Ov1Io1"/>
            <TextBlock x:Name="Ov1Io3"/>
            <TextBlock x:Name="Ov1Io4"/>
            <TextBlock x:Name="Ov1Io5"/>
            <TextBlock x:Name="Ov1Io6"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="CALIBRATION" x:Name="CalibrationWorkspaceTab">
        <Grid Background="{StaticResource ScadaBg}" Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- A. Calibration Header Bar -->
          <Border Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CALIBRATION WORKSPACE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}" VerticalAlignment="Center"/>
                <Border Background="#103028" CornerRadius="3" Padding="8,2" Margin="12,0,0,0" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1">
                  <TextBlock x:Name="CalibModeBadge" Text="OFFLINE EVALUATION &amp; GEOMETRIC PREVIEW" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaTeal}"/>
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="[4-CORNER GEOMETRIC PREVIEW ONLY · MASTER ENABLE SOURCE GATED PENDING COMMISSIONING]" Foreground="{StaticResource ScadaAmber}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
              <Button Grid.Column="2" Content="RETURN TO AUTO / LINE OVERVIEW" Click="ReturnToAuto_Click" MinHeight="26" Padding="12,2" FontSize="10" Background="#1B2B3A" Foreground="{StaticResource ScadaTextPrimary}"/>
            </Grid>
          </Border>

          <!-- B. Inner Calibration Sections (Tabs: LOCAL VIDEO & OPENCV | GANTRY 4-CORNER PREVIEW | LIVE CONVEYOR) -->
          <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <!-- TAB 1: LOCAL VIDEO & OPENCV OVERLAY -->
            <TabItem Header="LOCAL VIDEO &amp; OPENCV">
              <Grid Background="{StaticResource ScadaBg}" Margin="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="68*" MinWidth="500"/>
                  <ColumnDefinition Width="32*" MinWidth="320" MaxWidth="480"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Video Viewport -->
                <Border Grid.Column="0" Background="{StaticResource ScadaVideoBg}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Video Controls Toolbar -->
                    <Border Background="{StaticResource ScadaPanelHead}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,1" Padding="8,5">
                      <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="VIDEO FILE:" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="CalibVideoPathBox" Text="C:\Users\aml\Desktop\DEMO\1.avi" Width="240" MinHeight="25" Padding="5,1" FontSize="10" VerticalAlignment="Center" ToolTip="Enter or browse full path to a local AVI/MP4 video file."/>
                        <Button x:Name="CalibLoadPathBtn" Content="LOAD" Click="CalibLoadPath_Click" MinHeight="26" Padding="8,1" FontSize="10" Margin="4,0,4,0" Background="#163832" Foreground="{StaticResource ScadaTeal}" ToolTip="Loads and starts evaluation of the specified video file path."/>
                        <Button x:Name="CalibOpenVideoBtn" Content="BROWSE..." Click="CalibOpenVideo_Click" MinHeight="26" Padding="8,1" FontSize="10" Margin="0,0,4,0"/>
                        <Button x:Name="CalibLoadDemoBtn" Content="DEMO 1.avi" Click="CalibLoadDemo_Click" MinHeight="26" Padding="8,1" FontSize="10" Margin="0,0,4,0"/>
                        <Button x:Name="CalibPlayPauseBtn" Content="REPLAY" Click="CalibPlayPause_Click" MinHeight="26" Padding="8,1" FontSize="10" Margin="0,0,4,0" ToolTip="Replays the current active video file from the beginning."/>
                        <Button x:Name="CalibStopVideoBtn" Content="STOP" Click="CalibStopVideo_Click" MinHeight="26" Padding="8,1" FontSize="10" Margin="0,0,6,0" Background="#3A2024" Foreground="{StaticResource ScadaRed}"/>
                        <TextBlock x:Name="CalibVideoStatusText" Text="Ready to load video" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                      </WrapPanel>
                    </Border>
                    <!-- Video Display -->
                    <Grid Grid.Row="1">
                      <Image x:Name="CalibVideoPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <TextBlock x:Name="CalibVideoEmptyNotice" Text="NO VIDEO LOADED&#x0a;Click 'LOAD DEMO (1.avi)' or 'OPEN VIDEO FILE...'" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ScadaTextSecondary}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                    </Grid>
                  </Grid>
                </Border>

                <!-- Right Column: Video HUD & Info -->
                <Border Grid.Column="1" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="OPENCV DETECTION OVERLAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}" Margin="0,0,0,8"/>
                      <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="CENTROID (IMAGE PIXELS)" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/>
                          <TextBlock x:Name="CalibCentroidText" Text="X = — px, Y = — px" FontSize="14" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,2,0,6"/>
                          <TextBlock Text="TILT ANGLE θ (MODULO 90°)" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/>
                          <TextBlock x:Name="CalibAngleText" Text="θ = —° ([-45°, +45°))" FontSize="14" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" Margin="0,2,0,6"/>
                          <TextBlock Text="CONFIDENCE &amp; LATENCY" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/>
                          <TextBlock x:Name="CalibMetricsText" Text="Latency: — ms  |  Quality: —" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource ScadaTeal}" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Border>
                      <Border Background="#101F2D" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="OVERLAY RENDER SPEC" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,0,0,4"/>
                          <TextBlock Text="• Green contour bounding box&#x0a;• Crosshair at detected pixel centroid&#x0a;• In-frame label: X, Y, angle θ&#x0a;• Modulo normalized to [-45°, +45°)&#x0a;• Strictly pixel domain: zero physical mm or robot motion inference." FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </TabItem>

            <!-- TAB 2: GANTRY 4-CORNER PREVIEW -->
            <TabItem Header="GANTRY 4-CORNER PREVIEW">
              <Grid Background="{StaticResource ScadaBg}" Margin="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42*" MinWidth="360"/>
                  <ColumnDefinition Width="58*" MinWidth="480"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Explicit Manual Inputs -->
                <Border Grid.Column="0" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <Border Background="#2B1417" BorderBrush="{StaticResource ScadaRed}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="GANTRY LIVE TEST UNAVAILABLE — no commissioned command/feedback contract" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaRed}" TextWrapping="Wrap"/>
                          <TextBlock Text="Manual four-corner preview is strictly a mathematical geometric verification. No PLC writes or robot motion commands are dispatched." FontSize="9" Foreground="#F4A0A2" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                      </Border>

                      <TextBlock Text="WORKPIECE CENTER &amp; ANGLE (EXPLICIT)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}" Margin="0,0,0,6"/>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                          <TextBlock Text="Center X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="CalibCenterXBox" Text="" FontSize="11" ToolTip="Explicit finite workpiece center X in mm (Cartesian)."/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,0" Grid.Column="1">
                          <TextBlock Text="Center Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="CalibCenterYBox" Text="" FontSize="11" ToolTip="Explicit finite workpiece center Y in mm (Cartesian)."/>
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0" Grid.Column="2">
                          <TextBlock Text="Angle θ (deg CCW)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="CalibAngleBox" Text="" FontSize="11" ToolTip="Explicit finite tilt angle in degrees CCW."/>
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="HOLE PITCH (EXPLICIT, > 0)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}" Margin="0,6,0,6"/>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                          <TextBlock Text="Pitch X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="CalibPitchXBox" Text="" FontSize="11" ToolTip="Explicit finite hole pitch along X in mm (must be > 0)."/>
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0" Grid.Column="1">
                          <TextBlock Text="Pitch Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="CalibPitchYBox" Text="" FontSize="11" ToolTip="Explicit finite hole pitch along Y in mm (must be > 0)."/>
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="WORKSPACE BOUNDS ENVELOPE (MIN &lt; MAX)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}" Margin="0,6,0,6"/>
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,3,0">
                          <TextBlock Text="Min X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="CalibBoundMinXBox" Text="" FontSize="11" ToolTip="Explicit finite Min X workspace limit."/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,0" Grid.Column="1">
                          <TextBlock Text="Max X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="CalibBoundMaxXBox" Text="" FontSize="11" ToolTip="Explicit finite Max X workspace limit."/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,0" Grid.Column="2">
                          <TextBlock Text="Min Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="CalibBoundMinYBox" Text="" FontSize="11" ToolTip="Explicit finite Min Y workspace limit."/>
                        </StackPanel>
                        <StackPanel Margin="3,0,0,0" Grid.Column="3">
                          <TextBlock Text="Max Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="CalibBoundMaxYBox" Text="" FontSize="11" ToolTip="Explicit finite Max Y workspace limit."/>
                        </StackPanel>
                      </Grid>

                      <WrapPanel Margin="0,4,0,0">
                        <Button x:Name="CalibEvaluateCornersBtn" Content="EVALUATE 4 CORNERS" Click="CalibEvaluateCorners_Click" MinHeight="28" Padding="12,2" FontSize="11" Background="#163832" Foreground="{StaticResource ScadaTeal}" Margin="0,0,8,0"/>
                        <Button x:Name="CalibClearCornersBtn" Content="CLEAR" Click="CalibClearCorners_Click" MinHeight="28" Padding="10,2" FontSize="11" Background="{StaticResource ScadaBtn}"/>
                      </WrapPanel>
                      <TextBlock Text="All fields are required. Blank inputs fail closed." FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,8,0,0"/>
                      <!-- GANTRY MASTER ENABLE CONTROL (CANONICAL CONTRACT) -->
                      <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                        <StackPanel>
                          <TextBlock Text="GANTRY MASTER ENABLE (M0 / M10)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}" Margin="0,0,0,6"/>
                          <TextBlock Text="Gantry amplifier master enable handshake (TwinCAT Port 851). Controls M10 (0=ON, 1=OFF). Coils Y20..Y22 are command echoes, NOT physical drive ready." FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                          <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="GantryMasterOnBtn" Content="MASTER ENABLE ON" Click="GantryMasterOn_Click" IsEnabled="False" MinHeight="26" Padding="10,2" FontSize="10" FontWeight="Bold" Background="#163832" Foreground="{StaticResource ScadaTeal}" Margin="0,0,6,0" ToolTip="Command Gantry Master Enable ON (requests M10=0, SET M0)."/>
                            <Button x:Name="GantryMasterOffBtn" Content="MASTER ENABLE OFF" Click="GantryMasterOff_Click" IsEnabled="False" MinHeight="26" Padding="10,2" FontSize="10" FontWeight="Bold" Background="#4A1E24" Foreground="{StaticResource ScadaRed}" Margin="0,0,6,0" ToolTip="Command Gantry Master Enable OFF (requests M10=1, RST M0). Never drops brake during motion."/>
                            <Button x:Name="GantryMasterRefreshBtn" Content="REFRESH ECHOES" Click="GantryMasterRefresh_Click" IsEnabled="False" MinHeight="26" Padding="8,2" FontSize="9.5" Background="{StaticResource ScadaBtn}" ToolTip="Requests coherent readback refresh of M0..3, M10, Y20..22 without issuing commands."/>
                          </WrapPanel>

                          <Border Background="#0A1622" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel>
                              <TextBlock Text="STATUS (COMMAND ECHO &amp; READBACK):" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}"/>
                              <TextBlock x:Name="GantryMasterStatusText" Text="COMMAND ECHO: UNKNOWN (NO SNAPSHOT / OFFLINE)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                              <TextBlock x:Name="GantryMasterOverrideText" Text="OVERRIDES: STALE / UNKNOWN (SNAPSHOT INVALID)" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                              <TextBlock x:Name="GantryMasterGateText" Text="COMMISSIONING PENDING: Live gate closed · No UI bypass" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource ScadaRed}" TextWrapping="Wrap"/>
                              <TextBlock x:Name="GantryMasterDiagnosticsText" Text="DIAGNOSTICS: INITIALIZING" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource ScadaTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Border>

                <!-- Right Column: Computed 4-Corner Results & Verification -->
                <Border Grid.Column="1" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="12">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="CALCULATED 4-CORNER GEOMETRY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}" Margin="0,0,0,8"/>
                      <!-- Envelope Status Banner -->
                      <Border x:Name="CalibStatusBorder" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <TextBlock x:Name="CalibStatusBanner" Text="EVALUATION: PENDING INPUT (Enter all parameters and click EVALUATE)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource ScadaAmber}" TextWrapping="Wrap"/>
                      </Border>

                      <!-- Corners Display Grid -->
                      <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,4,4">
                          <StackPanel>
                            <TextBlock Text="POINT 1 (LOCAL QUAD I: +X, +Y)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                            <TextBlock x:Name="CalibP1Text" Text="P1: —" FontSize="12.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="4,0,0,4">
                          <StackPanel>
                            <TextBlock Text="POINT 2 (LOCAL QUAD II: -X, +Y)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                            <TextBlock x:Name="CalibP2Text" Text="P2: —" FontSize="12.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,4,4,0">
                          <StackPanel>
                            <TextBlock Text="POINT 3 (LOCAL QUAD III: -X, -Y)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                            <TextBlock x:Name="CalibP3Text" Text="P3: —" FontSize="12.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="4,4,0,0">
                          <StackPanel>
                            <TextBlock Text="POINT 4 (LOCAL QUAD IV: +X, -Y)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                            <TextBlock x:Name="CalibP4Text" Text="P4: —" FontSize="12.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>
                      </UniformGrid>

                      <!-- Geometry Verification Details -->
                      <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock Text="CALCULATED PITCH / ARITHMETIC CONSISTENCY" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}"/>
                          <TextBlock x:Name="CalibPitchVerifyText" Text="Calculated pitch / arithmetic consistency: —" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Border>

                      <TextBlock Text="Preview Isolation Guarantee: This preview is completely segregated from production TrackedWorkpiecePose, FIFO queues, TwinCAT ADS tags, and robot motion commands." FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </TabItem>

            <!-- TAB 3: LIVE CONVEYOR SUBSYSTEM -->
            <TabItem Header="LIVE CONVEYOR SUBSYSTEM">
              <Border Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="4">
                <StackPanel>
                  <Border Background="#1C2E40" BorderBrush="{StaticResource ScadaCyan}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock Text="LIVE HARDWARE CONVEYOR ONLY · REQUIRES COMMISSIONED ADS 851 &amp; MD200 DRIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                  </Border>
                  <TextBlock x:Name="CalibLiveConveyorNote" Text="Conveyor subsystem calibration controls are only active when connected to live TwinCAT ADS with commissioned hardware." FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                  <Button Content="OPEN SHARED CONVEYOR HARDWARE TAB" Click="DashOpenConveyor_Click" MinHeight="30" Padding="14,4" HorizontalAlignment="Left" FontSize="11"/>
                </StackPanel>
              </Border>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
      <TabItem Header="STATION 01" x:Name="GantryDetailTab">
        <Grid Background="{StaticResource ScadaBg}" Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- A. Page header -->
          <Grid Margin="0,0,0,4" MinHeight="26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="STATION 01" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="S1BadgeHost" Background="#103028" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,8,0" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1">
              <TextBlock x:Name="S1Badge" Text="CHECKING" Foreground="{StaticResource ScadaTeal}" FontSize="10" FontWeight="Bold"/>
            </Border>
            <Button Grid.Column="2" x:Name="S1SettingsButton" Content="STATION 01 SETTINGS" Click="StationSettings_Click" Tag="S1" MinHeight="28" Padding="12,3" FontSize="10.5"/>
          </Grid>

          <!-- B. Main Area: Camera View (Dominant ~72%) | Station Sidebar (~28%) -->
          <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72*" MinWidth="500"/>
              <ColumnDefinition Width="28*" MinWidth="320" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: DOMINANT CAMERA VIEWPORT -->
            <Border Grid.Column="0" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource ScadaPanelPrimary}" CornerRadius="5,5,0,0" Padding="8,5">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="S1CamBadge" Text="CAM 1" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="S1CamLinkText" Text="OFFLINE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
                <Grid Grid.Row="1">
                  <Image x:Name="Station1Preview" Source="{Binding Source,ElementName=Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <Canvas x:Name="S1Overlay" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="2" SizeChanged="S1Overlay_SizeChanged"/>
                  <TextBlock x:Name="S1CamEmpty" Text="OFFLINE" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ScadaTextSecondary}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
                  <UniformGrid VerticalAlignment="Bottom" Columns="3" Margin="8">
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4" Margin="0,0,5,0"><StackPanel><TextBlock Text="TRACK ID" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1TrackId" Text="--" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4" Margin="0,0,5,0"><StackPanel><TextBlock Text="DETECTION" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1DetectStatus" Text="OFF" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4"><StackPanel><TextBlock Text="CONFIDENCE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Confidence" Text="--" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                  </UniformGrid>
                </Grid>
              </Grid>
            </Border>

            <!-- Column 1: UNIFIED SIDEBAR (Tabs: STATUS & TRACKING | SENSORS & I/O | PARAMETERS | LOCAL EVENTS) -->
            <Border Grid.Column="1" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6">
              <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                  <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource ScadaTextSecondary}"/>
                    <Setter Property="Margin" Value="0,0,2,0"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                          <Border x:Name="ti" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="8,6">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="ti" Property="BorderBrush" Value="{StaticResource ScadaCyan}"/>
                              <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                              <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                              </MultiTrigger.Conditions>
                              <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}"/>
                            </MultiTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </TabControl.Resources>

                <!-- Tab 1: STATUS & TRACKING -->
                <TabItem Header="STATUS &amp; ROBOT">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6">
                    <StackPanel>
                      <!-- PRODUCT TRACKING -->
                      <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="PRODUCT TRACKING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                            <Border Grid.Column="1" Background="#103028" CornerRadius="3" Padding="6,2">
                              <TextBlock x:Name="S1QualityChip" Text="READ ONLY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource ScadaTeal}"/>
                            </Border>
                          </Grid>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,5,0,6"/>
                          <TextBlock Text="VISION POSE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/>
                          <TextBlock x:Name="S1Pose" Text="X --   Y --   θ --" FontSize="13" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,2,0,0"/>
                          <TextBlock x:Name="S1FrameQuality" Text="Frame quality: --" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,2,0,0"/>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,6"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Queue" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="S1QueueDepth" Text="NO DATA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Cycle" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="S1CycleStatus" Text="NO DATA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Text="4-point sequence" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S1Vertex" Text="NO DATA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                          </Grid>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,6,0,5"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Camera" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="S1CfgCamera" Text="Camera 1" FontSize="9.5" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Link" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="PLC-Q FIFO" FontSize="9.5" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                          </Grid>
                        </StackPanel>
                      </Border>

                      <!-- ROBOT TELEMETRY -->
                      <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                          <TextBlock Text="ROBOT TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,5,0,6"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Controller link" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="S1Link" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Robot ready" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="S1Ready" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Text="Robot mode" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S1Mode" Text="NO DATA" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Right" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="3" Text="Busy / fault" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="S1Busy" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Text="Homed" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="S1Homed" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                          </Grid>
                          <Border Background="#0A1622" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,8,0,0">
                            <StackPanel>
                              <TextBlock Text="ACTUAL ROBOT TCP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}"/>
                              <UniformGrid Columns="4" Margin="0,4,0,0">
                                <StackPanel><TextBlock Text="X" FontSize="8.5" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1X" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                                <StackPanel><TextBlock Text="Y" FontSize="8.5" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Y" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                                <StackPanel><TextBlock Text="Z" FontSize="8.5" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Z" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                                <StackPanel><TextBlock Text="Rz" FontSize="8.5" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Rz" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                              </UniformGrid>
                              <TextBlock Text="TCP: NOT AVAILABLE IN PLC IMAGE" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" Margin="0,4,0,0"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <!-- Tab 2: SENSORS & I/O -->
                <TabItem Header="I/O SIGNALS">
                  <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,5">
                      <WrapPanel Margin="0,0,0,4">
                        <Button Content="ALL" Tag="S1|ALL" Click="StationSensorGroup_Click" FontSize="9" Padding="6,2" MinHeight="22" Margin="0,0,3,0"/>
                        <Button Content="SAFETY" Tag="S1|SAFETY" Click="StationSensorGroup_Click" FontSize="9" Padding="6,2" MinHeight="22" Margin="0,0,3,0"/>
                        <Button Content="MOTION" Tag="S1|MOTION" Click="StationSensorGroup_Click" FontSize="9" Padding="6,2" MinHeight="22" Margin="0,0,3,0"/>
                        <Button Content="VISION" Tag="S1|VISION" Click="StationSensorGroup_Click" FontSize="9" Padding="6,2" MinHeight="22"/>
                      </WrapPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="S1SensorSearch" TextChanged="StationSensorSearch_Changed" Tag="S1" FontSize="9.5" MinHeight="22" Padding="6,1" VerticalAlignment="Center" ToolTip="Filter signals"/>
                        <TextBlock Grid.Column="1" x:Name="S1SensorCount" Text="0/0" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                      </Grid>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4">
                      <ListBox x:Name="S1SensorList" Background="Transparent" BorderThickness="0" Margin="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid Height="20">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Label}" Foreground="{StaticResource ScadaTextPrimary}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource ScadaTextSecondary}" FontFamily="Consolas" FontSize="9.5" VerticalAlignment="Center" Margin="4,0,8,0"/>
                              <Border Grid.Column="2" CornerRadius="2" Padding="5,1" Background="#0A1A26" VerticalAlignment="Center">
