                    <DataGrid Grid.Row="0" x:Name="PipelineTable" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="28" Background="{DynamicResource VDTheme009}" Foreground="{DynamicResource VDTheme038}" AlternatingRowBackground="#F2F5F7" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#D7DFE5" ColumnHeaderHeight="31" FontSize="12" SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                      <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                          <Setter Property="Background" Value="{DynamicResource VDTheme039}" />
                          <Setter Property="Foreground" Value="{DynamicResource VDTheme040}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                          <Setter Property="BorderBrush" Value="{DynamicResource VDTheme041}" />
                          <Setter Property="BorderThickness" Value="0,0,1,1" />
                          <Setter Property="Padding" Value="5,2" />
                        </Style>
                      </DataGrid.ColumnHeaderStyle>
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" />
                        <DataGridTextColumn Header="Track" Binding="{Binding TrackId}" Width="50" />
                        <DataGridTextColumn Header="Before → After / Line (px)" Binding="{Binding Crossing}" Width="225" />
                        <DataGridTextColumn Header="X / Y / Angle (mm, °)" Binding="{Binding Position}" Width="185" />
                        <DataGridTextColumn Header="Delivery Status" Binding="{Binding Delivery}" Width="175" />
                        <DataGridTextColumn Header="TwinCAT / FIFO ACK" Binding="{Binding Plc}" Width="230" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" x:Name="TriggerLog" Text="No trigger yet. A row is created only when the product center crosses the line." Foreground="{DynamicResource VDTheme042}" FontSize="10" Margin="3,3,0,0" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="2,2,0,6" Grid.Row="1">
                    <TextBlock Text="TRIGGER LINE" Foreground="{DynamicResource VDTheme043}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="Y↑  ·  50% FOV  ·  adjustable in Settings" Foreground="{DynamicResource VDTheme044}" FontSize="12" Margin="13,0,20,0" VerticalAlignment="Center" x:Name="TriggerSettingsSummary" />
                    <TextBlock Text="TRIGGER COUNT" Foreground="{DynamicResource VDTheme045}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TriggerCounter" Text="0" Foreground="{DynamicResource VDTheme046}" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" FontFamily="Consolas" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="DETECTION RESULTS" Style="{StaticResource SectionHeading}" />
                    <TextBlock x:Name="DetectState" Text="WAITING FOR START" Foreground="{DynamicResource VDTheme047}" FontSize="11" FontWeight="Bold" />
                    <Grid Margin="0,10,0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="CENTER X (mm)" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="CenterX" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource VDTheme046}" FontFamily="Consolas" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="CENTER Y (mm)" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="CenterY" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource VDTheme046}" FontFamily="Consolas" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="EDGE ANGLE RELATIVE TO X AXIS" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="AngleValue" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource VDTheme046}" FontFamily="Consolas" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                      <TextBlock x:Name="ConfidenceText" Text="Quality —" Foreground="{DynamicResource VDTheme048}" FontSize="11" />
                      <TextBlock Text="   /   " Foreground="{DynamicResource VDTheme049}" />
                      <TextBlock x:Name="ScaleText" Text="Scale —" Foreground="{DynamicResource VDTheme048}" FontSize="11" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="PLC / ENCODER STATUS" Style="{StaticResource SectionHeading}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="QUEUE DEPTH" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="FifoCount" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource VDTheme046}" FontFamily="Consolas" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="HEAD PRODUCT ID" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="FifoProduct" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource VDTheme046}" FontFamily="Consolas" />
                      </StackPanel>
                    </Grid>
                    <TextBlock x:Name="FifoProgress" Text="Tracking: ADS not connected" Foreground="{DynamicResource VDTheme050}" TextWrapping="Wrap" Margin="0,8,0,6" />
                    <TextBlock Text="4 GLUE POINTS / PLC LIVE" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="FifoGluePoints" Text="No active tracking" Foreground="{DynamicResource VDTheme051}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="3,3,0,8" />
                    <TextBlock x:Name="AdsStatus" Text="ADS not checked" Foreground="{DynamicResource VDTheme052}" TextWrapping="Wrap" FontSize="11" />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="FOUR GLUE POINT COORDINATES" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="P1–P4 COMPUTED FROM GEOMETRY  •  Pitch 40 × 40 mm" FontSize="11" Foreground="{DynamicResource VDTheme053}" />
                    <TextBlock x:Name="HoleCoordinates" Text="No product detected" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource VDTheme054}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Video mode supports image and coordinate tests only. No Gantry motion commands." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource VDTheme055}" Margin="0,9,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="CAMERA / SOURCE" x:Name="CameraSourceTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
          <StackPanel HorizontalAlignment="Stretch">
            <TextBlock Text="CAMERA DEVICES AND SOURCES" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource VDTheme056}" Margin="0,3,0,8" />
            <TextBlock Text="Configure the camera source here, then use Operation to view and control detection." Foreground="{DynamicResource VDTheme057}" TextWrapping="Wrap" Margin="0,0,0,18" />
            <Border Background="{StaticResource Panel}" CornerRadius="0" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="GigE Vision Cameras" Style="{StaticResource SectionHeading}" FontSize="14" />
                <TextBlock Text="Use the camera network on AML-IPC. Discover via GVCP or enter the device IP; do not change the camera IP." Foreground="{DynamicResource VDTheme058}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                <WrapPanel Margin="0,4,0,6">
                  <Button Content="SCAN CAMERAS" Click="ScanCameras_Click" Background="{DynamicResource VDTheme028}" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
                  <ComboBox x:Name="CameraPicker" Width="260" DisplayMemberPath="Name" />
                  <Button Content="CONNECT" Click="ConnectCamera_Click" MinHeight="30" Foreground="{DynamicResource VDTheme025}" />
                  <Button Content="CONNECT ALL" Click="ConnectAll_Click" Background="{DynamicResource VDTheme028}" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
                </WrapPanel>
                <WrapPanel Margin="0,4,0,6">
                  <TextBlock Text="IP camera" Foreground="{DynamicResource VDTheme059}" VerticalAlignment="Center" Margin="7,0,0,0" />
                  <TextBox x:Name="CameraIpBox" Width="174" Text="169.254.113.1" ToolTip="Hikrobot GigE Vision IPv4 address" />
                  <TextBlock Text="IP PC" Foreground="{DynamicResource VDTheme059}" VerticalAlignment="Center" />
                  <TextBox x:Name="HostIpBox" Width="174" Text="169.254.113.10" ToolTip="Ethernet 2 IPv4 on the camera subnet" />
                  <Button Content="CONNECT IP" Click="ConnectCameraIp_Click" Background="{DynamicResource VDTheme060}" ToolTip="Connect via Hikrobot SDK without MVS scanning" MinHeight="30" Foreground="{DynamicResource VDTheme025}" />
                </WrapPanel>
                <TextBlock Text="Example: camera 169.254.113.1, Ethernet 2: 169.254.113.10. Connecting opens Live View only." Foreground="{DynamicResource VDTheme061}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="0" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Video Source / Testing" Style="{StaticResource SectionHeading}" FontSize="14" />
                <TextBlock Text="Select an offline video to test the detection algorithm without real products." Foreground="{DynamicResource VDTheme058}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                <WrapPanel Margin="0,4,0,6">
                  <ComboBox x:Name="VideoPicker" Width="260" DisplayMemberPath="Name" />
                  <Button Content="PLAY VIDEO" Click="OpenDemo_Click" MinHeight="30" Foreground="{DynamicResource VDTheme025}" />
                  <Button Content="OPEN FILE..." Click="OpenFile_Click" Background="{DynamicResource VDTheme028}" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
                  <Button Content="PAUSE VIDEO" Click="Pause_Click" Background="{DynamicResource VDTheme028}" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
                </WrapPanel>
                <TextBlock Text="Demo video has no physical encoder synchronization. Start detection from the Operation tab." Foreground="{DynamicResource VDTheme062}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="0" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Connection Information" Style="{StaticResource SectionHeading}" FontSize="14" />
                <TextBlock Text="Camera source status and guidance appear in the bottom status bar." Foreground="{DynamicResource VDTheme058}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Content="GO TO OPERATION" Click="OpenMonitorPage_Click" Background="{DynamicResource VDTheme028}" HorizontalAlignment="Left" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      </TabControl>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource ScadaTopBg}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,1,0,0" Padding="10,0">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Start with an offline video demo; never command PLC motion from this view." Foreground="{StaticResource ScadaTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="HMI FEEDBACK IS NOT A CERTIFIED SAFETY FUNCTION" Foreground="{StaticResource ScadaAmber}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>