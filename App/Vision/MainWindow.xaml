                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border Background="#112335" BorderBrush="#23384D" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock Text="COMMISSIONING PREREQUISITES" FontSize="11" FontWeight="Bold" Foreground="#27C9EC"/>
