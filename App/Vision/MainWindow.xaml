                    <StackPanel>
                      <TextBlock Text="DETECTION / TRIGGER · STATION 01" FontSize="12" FontWeight="Bold" Foreground="#27C9EC"/>
                      <TextBlock Text="Track objects before they cross the reference line. Each Track ID triggers once. Only image processing is affected." FontSize="10" Foreground="#B9CBD8" TextWrapping="Wrap" Margin="0,5,0,9"/>
                      <WrapPanel>
                        <TextBlock Text="Conveyor direction" VerticalAlignment="Center" FontSize="10" Foreground="#92AABE" Margin="0,0,7,0"/>
