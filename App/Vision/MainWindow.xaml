  </Window.Resources>
    <Grid Background="{StaticResource ScadaBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="43" />
      <RowDefinition Height="*" />
      <RowDefinition Height="20" />
    </Grid.RowDefinitions>

    <!-- Top bar: brand + global read-only status. Approved compact density. -->
    <Border Grid.Row="0" Background="{StaticResource ScadaTopBg}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,1" Padding="12,0">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="DATN" FontSize="19" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center" />
        <Border Grid.Column="1" Width="1" Height="21" Background="{StaticResource ScadaBorder}" Margin="13,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="LINE CONTROL SCADA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ShellAdsDot" Width="6" Height="6" Fill="{StaticResource ScadaAmber}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock x:Name="ControlSafetyBanner" Text="ADS READ-ONLY · NO MOTION" Foreground="{StaticResource ScadaTextSecondary}" FontSize="10" VerticalAlignment="Center"/>
          <CheckBox x:Name="DarkModeBox" Content="Theme" IsChecked="True" Visibility="Collapsed" Checked="DarkModeChanged" Unchecked="DarkModeChanged" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Horizontal tab navigation replaces the old 170px sidebar to reclaim page width. -->
    <Border Grid.Row="1" Background="{StaticResource ScadaNavBg}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,0" Padding="5,0,0,0">
      <TabControl x:Name="MainNavigation" TabStripPlacement="Top" Background="Transparent" BorderThickness="0" Margin="0" Padding="0" SelectedIndex="0">
        <TabControl.Resources>
          <Style TargetType="TabItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ScadaTextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                  <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="13,0">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource ScadaPanelHover}" />
                      <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource ScadaBorderBright}" />
                      <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}" />
                    </Trigger>
                    <MultiTrigger>
                      <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsSelected" Value="False" />
                      </MultiTrigger.Conditions>
                      <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource ScadaPanelPrimary}" />
                      <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}" />
                    </MultiTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </TabControl.Resources>
      <!-- LARGE_CAMERA_OVERVIEW_V2: camera+station I/O dominate the first screen. -->
      <TabItem Header="LINE OVERVIEW" x:Name="DashboardTab">
        <Grid Background="{StaticResource ScadaBg}" Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Two cameras share the width 50/50 and take all remaining vertical space. -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="29"/>
                  <RowDefinition Height="*" MinHeight="80"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource ScadaPanelHead}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,1" Padding="8,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="CAM 1 · GANTRY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="Ov1CamStatus" Text="OFFLINE" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Grid.Column="2" x:Name="Ov1BadgeHost" Background="{StaticResource ScadaPanelSecondary}" CornerRadius="2" Padding="6,1" VerticalAlignment="Center">
                      <TextBlock x:Name="Ov1Badge" Text="CHECKING" Foreground="{StaticResource ScadaTeal}" FontSize="9" FontWeight="Bold"/>
                    </Border>
                  </Grid>
                </Border>
                <Grid Grid.Row="1" Background="{StaticResource ScadaVideoBg}">
                  <Image x:Name="Ov1CamImage" Source="{Binding Source,ElementName=Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock x:Name="Ov1CamEmpty" Text="CAM 1 OFFLINE · NO FRAME" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ScadaTextSecondary}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
                </Grid>
                <UniformGrid Grid.Row="2" Columns="4" Background="{StaticResource ScadaPanelSecondary}">
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="TRACK ID" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="Ov1Track" Text="--" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="GANTRY / PLC-Q" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="Ov1Link" Text="NO DATA" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="PRODUCT X / Y" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="Ov1Pose" Text="-- / -- mm" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="SERVO / MODE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="Ov1Servo" Text="NO DATA" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                </UniformGrid>
              </Grid>
            </Border>

            <Rectangle Grid.Column="1" Fill="{StaticResource ScadaBorder}"/>

            <Border Grid.Column="2" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="29"/>
                  <RowDefinition Height="*" MinHeight="80"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource ScadaPanelHead}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,1" Padding="8,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="CAM 2 · SCARA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="Ov2CamStatus" Text="OFFLINE" FontSize="10" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Grid Grid.Row="1" Background="{StaticResource ScadaVideoBg}">
                  <Image x:Name="Ov2CamImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <StackPanel x:Name="Ov2CamEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="NO SIGNAL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="CAM 2 OFFLINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="SCARA not commissioned" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
                <UniformGrid Grid.Row="2" Columns="4" Background="{StaticResource ScadaPanelSecondary}">
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="TRACK ID" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock Text="--" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="TRACKING" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock Text="UNAVAILABLE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="PRODUCT X / Y" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock Text="-- / -- mm" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel></Border>
                  <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="7,4"><StackPanel><TextBlock Text="SCARA ROBOT" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock Text="NOT COMM." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                </UniformGrid>
              </Grid>
            </Border>
          </Grid>

          <!-- Shared conveyor telemetry + machine commands, one compact strip under both cameras. -->
          <Border Grid.Row="1" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" Margin="0,5,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Background="{StaticResource ScadaPanelHead}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,0,0,1" Padding="8,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="CONVEYOR + COMMANDS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="OvUpdated" Text="Reading PLC..." FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="CONTRACT PENDING" FontSize="9" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>

              <UniformGrid Grid.Row="1" Columns="4" Background="{StaticResource ScadaPanelSecondary}">
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="RUN" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvRun" Text="NO DATA" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="ACTUAL (mm/s)" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvSpeed" Text="-- mm/s" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="POSITION (mm)" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvDistance" Text="-- mm" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="MODE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvCommand" Text="DISARMED" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
              </UniformGrid>

              <StackPanel Grid.Row="2" Margin="8,5,8,4">
                <WrapPanel VerticalAlignment="Center">
                  <TextBlock Text="SPEED (mm/s)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox x:Name="OvPresetSpeedBox" Text="100" Width="64" MinHeight="25" Padding="5,1" FontSize="11" HorizontalContentAlignment="Right" LostFocus="PresetSpeed_LostFocus" ToolTip="Shared LINE / SHARED CONVEYOR preset in mm/s. Local preset only; no PLC setpoint write exists."/>
                  <Button x:Name="OvPresetApplyButton" Content="APPLY" Click="PresetSpeedApply_Click" MinWidth="50" MinHeight="25" Padding="6,1" FontSize="10" Margin="6,0,0,0" ToolTip="Stores the mm/s preset used by the AUTO request. No ADS write is performed."/>
                  <Rectangle Width="1" Height="20" Fill="{StaticResource ScadaBorder}" Margin="10,0"/>
                  <Button x:Name="SysStartButton" Content="START" Click="SysLineStart_Click" IsEnabled="False" MinWidth="62" MinHeight="25" Padding="8,1" FontSize="11" ToolTip="One operator START: PC vision tracking and the conveyor request go together. Disabled while any prerequisite is unknown, stale or uncommissioned."/>
                  <Button x:Name="SysStopButton" Content="STOP" Click="SysLineStop_Click" IsEnabled="False" MinWidth="58" MinHeight="25" Padding="6,1" FontSize="11" Margin="4,0,0,0" ToolTip="Requests the normal coordinated stop (tracking + conveyor request). NOT a certified emergency stop."/>
                  <Button x:Name="SysResetButton" Content="RESET" Click="SysLineReset_Click" IsEnabled="False" MinWidth="58" MinHeight="25" Padding="6,1" FontSize="11" Margin="4,0,0,0" ToolTip="Clears the HMI stop latch only after a stop request or fault. It never resets a physical drive or robot fault."/>
                  <Rectangle Width="1" Height="20" Fill="{StaticResource ScadaBorder}" Margin="10,0"/>
                  <Button x:Name="OvVisionStartButton" Content="VISION START" Click="StationVisionStart_Click" MinWidth="90" MinHeight="25" Padding="6,1" FontSize="9.5" ToolTip="PC-only detection. Does not start the conveyor and is not a line START."/>
                  <Button x:Name="OvVisionStopButton" Content="VISION STOP" Click="StationVisionStop_Click" MinWidth="86" MinHeight="25" Padding="6,1" FontSize="9.5" Margin="4,0,0,0" ToolTip="Stops detection only; camera view remains live. NOT a machine stop."/>
                </WrapPanel>
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <UniformGrid Grid.Column="0" Columns="4">
                    <TextBlock x:Name="OvIlAds" Text="○ ADS 851" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlEstop" Text="○ E-STOP AUX" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlPlcQ" Text="○ PLC-Q LINK" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlGantry" Text="○ GANTRY FAULT" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlCamera" Text="○ CAM 1 FRAME" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlSpeed" Text="○ SPEED PRESET" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlMaster" Text="○ AUTO CONTRACT" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OvIlScara" Text="○ STATION 02 EXCLUDED" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                  </UniformGrid>
                  <TextBlock Grid.Column="1" x:Name="OvStartReason" Text="NOT EVALUATED" FontSize="9" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" MaxWidth="420" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <TextBlock x:Name="OvPresetHz" Text="Hz: NOT CALIBRATED" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="OvPresetError" Text="" FontSize="9" Foreground="{StaticResource ScadaRed}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
              </StackPanel>

              <Border Grid.Row="3" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,1,0,0" Padding="8,3">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="OvCvQuality" Text="NO DATA" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" x:Name="OvAlarm" Text="No PLC alarm data." FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="COMMANDS NOT COMMISSIONED" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- Legacy dashboard data sinks: unchanged writers, never shown. -->
          <StackPanel Grid.Row="2" Visibility="Collapsed">
            <TextBlock x:Name="DashUpdated"/>
            <TextBlock x:Name="OverviewGlobalAuthority"/>
            <Image x:Name="OverviewCam1Image" Source="{Binding Source,ElementName=Preview}"/>
            <TextBlock x:Name="OverviewCam1Quality"/>
            <TextBlock x:Name="OverviewCam1Empty"/>
            <TextBlock x:Name="OverviewIoEstop"/>
            <TextBlock x:Name="OverviewIoServo"/>
            <TextBlock x:Name="OverviewIoPlcQ"/>
            <TextBlock x:Name="OverviewIoGantryBusy"/>
            <TextBlock x:Name="OverviewIoGantryAlarm"/>
            <TextBlock x:Name="OverviewIoVision"/>
            <TextBlock x:Name="OverviewIoBeltDO"/>
            <TextBlock x:Name="OverviewIoMd200Cmd"/>
            <TextBlock x:Name="OverviewIoEncoder"/>
            <TextBlock x:Name="OverviewIoAo"/>
            <TextBlock x:Name="OverviewCam1Track"/>
            <TextBlock x:Name="OverviewCam1Pose"/>
            <TextBlock x:Name="DashSpeed"/>
            <TextBlock x:Name="DashBeltState"/>
            <TextBlock x:Name="DashDistance"/>
            <TextBlock x:Name="DashBeltMmS"/>
            <TextBlock x:Name="Ov1Ready"/>
            <TextBlock x:Name="Ov1Mode"/>
            <TextBlock x:Name="Ov1Busy"/>
            <TextBlock x:Name="Ov1Homed"/>
            <TextBlock x:Name="Ov1X"/>
            <TextBlock x:Name="Ov1Y"/>
            <TextBlock x:Name="Ov1Z"/>
            <TextBlock x:Name="Ov1Rz"/>
            <TextBlock x:Name="Ov1Io1"/>
            <TextBlock x:Name="Ov1Io2"/>
            <TextBlock x:Name="Ov1Io3"/>
            <TextBlock x:Name="Ov1Io4"/>
            <TextBlock x:Name="Ov1Io5"/>
            <TextBlock x:Name="Ov1Io6"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="STATION 01" x:Name="GantryDetailTab">
        <Grid Background="{StaticResource ScadaBg}" Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- A. Page header -->
          <Grid Margin="0,0,0,4" MinHeight="26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="STATION 01" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="S1BadgeHost" Background="#103028" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,8,0" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1">
              <TextBlock x:Name="S1Badge" Text="CHECKING" Foreground="{StaticResource ScadaTeal}" FontSize="10" FontWeight="Bold"/>
            </Border>
            <Button Grid.Column="2" x:Name="S1SettingsButton" Content="STATION 01 SETTINGS" Click="StationSettings_Click" Tag="S1" MinHeight="28" Padding="12,3" FontSize="10.5"/>
          </Grid>

          <!-- B. Main Area: Camera View (Dominant ~72%) | Station Sidebar (~28%) -->
          <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72*" MinWidth="500"/>
              <ColumnDefinition Width="28*" MinWidth="320" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: DOMINANT CAMERA VIEWPORT -->
            <Border Grid.Column="0" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource ScadaPanelPrimary}" CornerRadius="5,5,0,0" Padding="8,4">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="S1CamBadge" Text="CAM 1" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
                      <ComboBox x:Name="S1ModeBox" Grid.Column="2" Width="62" MinHeight="22" FontSize="9.5" SelectedIndex="0" SelectionChanged="S1ModeChanged" ToolTip="IP enumerates Hikrobot/Basler GigE plus read-only GVCP; USB enumerates USB3 Vision. Auto is removed.">
                        <ComboBoxItem Content="IP"/><ComboBoxItem Content="USB"/>
                      </ComboBox>
                      <ComboBox x:Name="S1DeviceBox" Grid.Column="4" MinWidth="130" MinHeight="22" FontSize="9.5" DisplayMemberPath="Display" SelectionChanged="S1DeviceChanged" ToolTip="Scanned Hikrobot/Basler device: model · serial · vendor · transport."/>
                      <Button x:Name="S1ScanButton" Grid.Column="5" Content="SCAN" Click="S1Scan_Click" MinWidth="48" MinHeight="22" Padding="6,0" FontSize="9" Margin="4,0,0,0"/>
                      <Button x:Name="S1ConnectButton" Grid.Column="6" Content="CONNECT" Click="S1ConnectCamera_Click" MinWidth="64" MinHeight="22" Padding="6,0" FontSize="9" Margin="4,0,0,0"/>
                      <Button x:Name="S1DisconnectButton" Grid.Column="7" Content="DISCONNECT" Click="S1DisconnectCamera_Click" MinWidth="78" MinHeight="22" Padding="6,0" FontSize="9" Margin="4,0,0,0"/>
                      <TextBlock x:Name="S1CamLinkText" Grid.Column="8" Text="OFFLINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    </Grid>
                    <WrapPanel x:Name="S1IpRow" Margin="0,4,0,0" Visibility="Collapsed">
                      <TextBlock Text="IP" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                      <TextBox x:Name="S1CamIpBox" Width="112" MinHeight="22" Padding="4,0" FontSize="10" TextChanged="S1IpTextChanged" ToolTip="GigE IPv4 address or hostname. Only IP mode requires it."/>
                      <TextBlock Text="NIC" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                      <TextBox x:Name="S1HostIpBox" Width="112" MinHeight="22" Padding="4,0" FontSize="10" ToolTip="Local NIC IPv4 for GVCP discovery and Hikrobot direct-IP connect; auto-detected when the camera subnet is local."/>
                      <TextBlock Text="VENDOR" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                      <ComboBox x:Name="S1VendorBox" Width="88" MinHeight="22" FontSize="9.5" SelectedIndex="0" ToolTip="Typed-IP manual connect is supported for HIKROBOT only. BASLER devices need SCAN.">
                        <ComboBoxItem Content="HIKROBOT"/><ComboBoxItem Content="BASLER"/>
                      </ComboBox>
                    </WrapPanel>
                    <Expander x:Name="S1DetailsExpander" Margin="0,4,0,0" FontSize="9.5" Visibility="Collapsed">
                      <Expander.Header><TextBlock x:Name="S1DetailsHeader" Text="DETAILS" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}"/></Expander.Header>
                      <TextBlock x:Name="S1DetailsText" TextWrapping="Wrap" MaxHeight="120" FontFamily="Consolas" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                    </Expander>
                  </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                  <Image x:Name="Station1Preview" Source="{Binding Source,ElementName=Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <Canvas x:Name="S1Overlay" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="2" SizeChanged="S1Overlay_SizeChanged"/>
                  <TextBlock x:Name="S1CamEmpty" Text="OFFLINE" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ScadaTextSecondary}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
                  <UniformGrid VerticalAlignment="Bottom" Columns="3" Margin="8">
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4" Margin="0,0,5,0"><StackPanel><TextBlock Text="TRACK ID" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1TrackId" Text="--" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4" Margin="0,0,5,0"><StackPanel><TextBlock Text="DETECTION" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1DetectStatus" Text="OFF" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4"><StackPanel><TextBlock Text="CONFIDENCE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Confidence" Text="--" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                  </UniformGrid>
                </Grid>
              </Grid>
            </Border>

            <!-- Column 1: UNIFIED SIDEBAR (Tabs: STATUS & TRACKING | SENSORS & I/O | PARAMETERS | LOCAL EVENTS) -->
            <Border Grid.Column="1" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6">
              <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                  <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource ScadaTextSecondary}"/>
                    <Setter Property="Margin" Value="0,0,2,0"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                          <Border x:Name="ti" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="8,6">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="ti" Property="BorderBrush" Value="{StaticResource ScadaCyan}"/>
                              <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                              <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                              </MultiTrigger.Conditions>
                              <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}"/>
                            </MultiTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </TabControl.Resources>

                <!-- Tab 1: STATUS & TRACKING -->
                <TabItem Header="STATUS &amp; ROBOT">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6">
                    <StackPanel>
                      <!-- PRODUCT TRACKING -->
                      <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="PRODUCT TRACKING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                            <Border Grid.Column="1" Background="#103028" CornerRadius="3" Padding="6,2">
                              <TextBlock x:Name="S1QualityChip" Text="READ ONLY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource ScadaTeal}"/>
                            </Border>
                          </Grid>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,5,0,6"/>
                          <TextBlock Text="VISION POSE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/>
                          <TextBlock x:Name="S1Pose" Text="X --   Y --   θ --" FontSize="13" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,2,0,0"/>
                          <TextBlock x:Name="S1FrameQuality" Text="Frame quality: --" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,2,0,0"/>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,6"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Queue" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="S1QueueDepth" Text="NO DATA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Cycle" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="S1CycleStatus" Text="NO DATA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Text="4-point sequence" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S1Vertex" Text="NO DATA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                          </Grid>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,6,0,5"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Camera" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="S1CfgCamera" Text="Camera 1" FontSize="9.5" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Link" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="PLC-Q FIFO" FontSize="9.5" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                          </Grid>
                        </StackPanel>
                      </Border>

                      <!-- ROBOT TELEMETRY -->
                      <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                          <TextBlock Text="ROBOT TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,5,0,6"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Controller link" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="S1Link" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Robot ready" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="S1Ready" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Text="Servo state" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S1Servo" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Text="Robot mode" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="S1Mode" Text="NO DATA" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Right" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="4" Text="Busy / fault" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="S1Busy" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="5" Text="Homed" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="S1Homed" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                          </Grid>
                          <Border Background="#0A1622" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,8,0,0">
                            <StackPanel>
                              <TextBlock Text="ACTUAL ROBOT TCP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}"/>
                              <UniformGrid Columns="4" Margin="0,4,0,0">
                                <StackPanel><TextBlock Text="X" FontSize="8.5" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1X" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                                <StackPanel><TextBlock Text="Y" FontSize="8.5" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Y" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                                <StackPanel><TextBlock Text="Z" FontSize="8.5" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Z" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                                <StackPanel><TextBlock Text="Rz" FontSize="8.5" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Rz" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                              </UniformGrid>
                              <TextBlock Text="TCP: NOT AVAILABLE IN PLC IMAGE" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" Margin="0,4,0,0"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <!-- Tab 2: SENSORS & I/O -->
                <TabItem Header="I/O SIGNALS">
                  <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,5">
                      <WrapPanel Margin="0,0,0,4">
                        <Button Content="ALL" Tag="S1|ALL" Click="StationSensorGroup_Click" FontSize="9" Padding="6,2" MinHeight="22" Margin="0,0,3,0"/>
                        <Button Content="SAFETY" Tag="S1|SAFETY" Click="StationSensorGroup_Click" FontSize="9" Padding="6,2" MinHeight="22" Margin="0,0,3,0"/>
                        <Button Content="MOTION" Tag="S1|MOTION" Click="StationSensorGroup_Click" FontSize="9" Padding="6,2" MinHeight="22" Margin="0,0,3,0"/>
                        <Button Content="VISION" Tag="S1|VISION" Click="StationSensorGroup_Click" FontSize="9" Padding="6,2" MinHeight="22"/>
                      </WrapPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="S1SensorSearch" TextChanged="StationSensorSearch_Changed" Tag="S1" FontSize="9.5" MinHeight="22" Padding="6,1" VerticalAlignment="Center" ToolTip="Filter signals"/>
                        <TextBlock Grid.Column="1" x:Name="S1SensorCount" Text="0/0" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                      </Grid>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4">
                      <ListBox x:Name="S1SensorList" Background="Transparent" BorderThickness="0" Margin="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid Height="20">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Label}" Foreground="{StaticResource ScadaTextPrimary}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource ScadaTextSecondary}" FontFamily="Consolas" FontSize="9.5" VerticalAlignment="Center" Margin="4,0,8,0"/>
                              <Border Grid.Column="2" CornerRadius="2" Padding="5,1" Background="#0A1A26" VerticalAlignment="Center">
                                <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontSize="8.5" FontWeight="Bold"/>
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="3,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                          </Style>
                        </ListBox.ItemContainerStyle>
                      </ListBox>
                    </Border>
                  </Grid>
                </TabItem>

                <!-- Tab 3: PARAMETERS -->
                <TabItem Header="PARAMS">
                  <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="S1ParamCount" Text="0 parameters" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="2,0,0,4"/>
                    <Border Grid.Row="1" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4">
                      <ListBox x:Name="S1ParamList" Background="Transparent" BorderThickness="0" Margin="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid Height="20">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Label}" Foreground="{StaticResource ScadaTextPrimary}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource ScadaTextPrimary}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="6,0,4,0"/>
                              <TextBlock Grid.Column="2" Text="{Binding Unit}" Foreground="{StaticResource ScadaTextSecondary}" FontSize="8.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="3,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                          </Style>
                        </ListBox.ItemContainerStyle>
                      </ListBox>
                    </Border>
                  </Grid>
                </TabItem>

                <!-- Tab 4: LOCAL EVENTS -->
                <TabItem Header="EVENTS">
                  <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4">
                      <ListBox x:Name="S1EventList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ScadaTextPrimary}" FontFamily="Consolas" FontSize="9.5" Margin="4"/>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,5,0,0">
                      <Button Content="VISION WORKSPACE" Click="OpenVisionWorkspace_Click" FontSize="9" Padding="8,2" MinHeight="22"/>
                    </StackPanel>
                  </Grid>
                </TabItem>
              </TabControl>
            </Border>
          </Grid>

          <!-- C. Local alarm strip -->
          <Border Grid.Row="2" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="5" Padding="10,5">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="LOCAL ALARM" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" x:Name="S1AlarmStrip" Text="No alarm data yet. Detailed history is on ALARMS &amp; LOGS." FontSize="10" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="2" Text="NO ROBOT COMMANDS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaRed}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="STATION 02" x:Name="ScaraDetailTab">
        <Grid Background="{StaticResource ScadaBg}" Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- A. Page header -->
          <Grid Margin="0,0,0,4" MinHeight="26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="STATION 02" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#332A12" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock Text="NOT COMMISSIONED" Foreground="{StaticResource ScadaAmber}" FontSize="10" FontWeight="Bold"/>
            </Border>
            <Button Grid.Column="2" x:Name="S2SettingsButton" Content="STATION 02 SETTINGS" Click="StationSettings_Click" Tag="S2" MinHeight="28" Padding="12,3" FontSize="10.5"/>
          </Grid>

          <!-- B. Main Area: Camera View (Dominant ~72%) | Station Sidebar (~28%) -->
          <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72*" MinWidth="500"/>
              <ColumnDefinition Width="28*" MinWidth="320" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: DOMINANT CAMERA 2 VIEWPORT -->
            <Border Grid.Column="0" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource ScadaPanelPrimary}" CornerRadius="5,5,0,0" Padding="8,4">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="S2CamBadge" Text="CAM 2" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
                      <ComboBox x:Name="S2ModeBox" Grid.Column="2" Width="62" MinHeight="22" FontSize="9.5" SelectedIndex="1" SelectionChanged="S2ModeChanged" ToolTip="IP enumerates Hikrobot/Basler GigE plus read-only GVCP; USB enumerates USB3 Vision. Auto is removed.">
                        <ComboBoxItem Content="IP"/><ComboBoxItem Content="USB"/>
                      </ComboBox>
                      <ComboBox x:Name="S2DeviceBox" Grid.Column="4" MinWidth="130" MinHeight="22" FontSize="9.5" DisplayMemberPath="Display" SelectionChanged="S2DeviceChanged" ToolTip="Scanned Hikrobot/Basler device: model · serial · vendor · transport."/>
                      <Button x:Name="S2ScanButton" Grid.Column="5" Content="SCAN" Click="S2Scan_Click" MinWidth="48" MinHeight="22" Padding="6,0" FontSize="9" Margin="4,0,0,0"/>
                      <Button x:Name="S2ConnectButton" Grid.Column="6" Content="CONNECT" Click="S2ConnectCamera_Click" MinWidth="64" MinHeight="22" Padding="6,0" FontSize="9" Margin="4,0,0,0"/>
                      <Button x:Name="S2DisconnectButton" Grid.Column="7" Content="DISCONNECT" Click="S2DisconnectCamera_Click" MinWidth="78" MinHeight="22" Padding="6,0" FontSize="9" Margin="4,0,0,0"/>
                      <TextBlock x:Name="S2CamLinkText" Grid.Column="8" Text="OFFLINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    </Grid>
                    <WrapPanel x:Name="S2IpRow" Margin="0,4,0,0" Visibility="Collapsed">
                      <TextBlock Text="IP" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                      <TextBox x:Name="S2CamIpBox" Width="112" MinHeight="22" Padding="4,0" FontSize="10" TextChanged="S2IpTextChanged" ToolTip="GigE IPv4 address or hostname. Only IP mode requires it."/>
                      <TextBlock Text="NIC" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                      <TextBox x:Name="S2HostIpBox" Width="112" MinHeight="22" Padding="4,0" FontSize="10" ToolTip="Local NIC IPv4 for GVCP discovery and Hikrobot direct-IP connect; auto-detected when the camera subnet is local."/>
                      <TextBlock Text="VENDOR" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                      <ComboBox x:Name="S2VendorBox" Width="88" MinHeight="22" FontSize="9.5" SelectedIndex="0" ToolTip="Typed-IP manual connect is supported for HIKROBOT only. BASLER devices need SCAN.">
                        <ComboBoxItem Content="HIKROBOT"/><ComboBoxItem Content="BASLER"/>
                      </ComboBox>
                    </WrapPanel>
                    <Expander x:Name="S2DetailsExpander" Margin="0,4,0,0" FontSize="9.5" Visibility="Collapsed">
                      <Expander.Header><TextBlock x:Name="S2DetailsHeader" Text="DETAILS" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}"/></Expander.Header>
                      <TextBlock x:Name="S2DetailsText" TextWrapping="Wrap" MaxHeight="120" FontFamily="Consolas" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                    </Expander>
                  </StackPanel>
                </Border>
                <Grid Grid.Row="1" Background="{StaticResource ScadaVideoBg}">
                  <Image x:Name="Station2Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <StackPanel x:Name="S2CamEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300">
                    <TextBlock Text="CAM 2" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="S2CamHint" Text="OFFLINE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="SCARA not commissioned" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                  <UniformGrid VerticalAlignment="Bottom" Columns="3" Margin="8">
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4" Margin="0,0,5,0"><StackPanel><TextBlock Text="TRACK ID" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S2Track" Text="--" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel></Border>
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4" Margin="0,0,5,0"><StackPanel><TextBlock Text="DETECTION" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S2Detect" Text="NO DATA" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}"/></StackPanel></Border>
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4"><StackPanel><TextBlock Text="CONFIDENCE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S2Confidence" Text="--" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel></Border>
                  </UniformGrid>
                </Grid>
              </Grid>
            </Border>

            <!-- Column 1: UNIFIED SIDEBAR (Tabs: STATUS & TRACKING | SENSORS & I/O | PARAMETERS | LOCAL EVENTS) -->
            <Border Grid.Column="1" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6">
              <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                  <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource ScadaTextSecondary}"/>
                    <Setter Property="Margin" Value="0,0,2,0"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                          <Border x:Name="ti2" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="8,6">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="ti2" Property="BorderBrush" Value="{StaticResource ScadaCyan}"/>
                              <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                              <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                              </MultiTrigger.Conditions>
                              <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}"/>
                            </MultiTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </TabControl.Resources>

                <!-- Tab 1: STATUS & TRACKING -->
                <TabItem Header="STATUS &amp; ROBOT">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6">
                    <StackPanel>
                      <!-- PRODUCT TRACKING -->
                      <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="PRODUCT TRACKING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <Border Grid.Column="1" Background="#332A12" CornerRadius="3" Padding="6,2">
                              <TextBlock Text="LOCKED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource ScadaAmber}"/>
                            </Border>
                          </Grid>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,5,0,6"/>
                          <TextBlock Text="VISION POSE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/>
                          <TextBlock x:Name="S2Pose" Text="X --   Y --   θ --" FontSize="13" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" Margin="0,2,0,0"/>
                          <TextBlock x:Name="S2FrameQuality" Text="Frame quality: --" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,2,0,0"/>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,6"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Queue" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="S2QueueDepth" TextTrimming="CharacterEllipsis" Text="UNMAPPED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Cycle" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="S2CycleStatus" Text="NOT COMM." FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Text="Pick/place sequence" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S2Vertex" Text="--" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                          </Grid>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,6,0,5"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Role" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="Tray pick/place" FontSize="9.5" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Robot" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="SCARA · planned" FontSize="9.5" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Text="Camera" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S2CfgCamera" Text="CAM 2" FontSize="9.5" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="3" Text="Link" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Not defined" FontSize="9.5" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                          </Grid>
                        </StackPanel>
                      </Border>

                      <!-- ROBOT TELEMETRY -->
                      <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                          <TextBlock Text="ROBOT TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                          <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,5,0,6"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Controller link" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                            <TextBlock Grid.Column="1" x:Name="S2Link" Text="UNMAPPED" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Robot ready" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="S2Ready" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Text="Servo state" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S2Servo" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
