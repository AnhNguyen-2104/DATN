                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="mm per pixel (0 = geometric estimate)" Style="{StaticResource FieldLabel}"/>
