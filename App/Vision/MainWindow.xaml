                          <TextBlock Text="Min X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayBoundMinXBox" Text="" FontSize="11" ToolTip="Explicit finite Min X workspace limit."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                          <TextBlock Text="Max X (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayBoundMaxXBox" Text="" FontSize="11" ToolTip="Explicit finite Max X workspace limit."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                          <TextBlock Text="Min Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayBoundMinYBox" Text="" FontSize="11" ToolTip="Explicit finite Min Y workspace limit."/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="Max Y (mm)" Style="{StaticResource FieldLabel}"/>
                          <TextBox x:Name="SettingsS2TrayBoundMaxYBox" Text="" FontSize="11" ToolTip="Explicit finite Max Y workspace limit."/>
                        </StackPanel>
                      </Grid>

                      <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="SettingsS2ApplyConfigButton" Content="APPLY OFFLINE CONFIG" Click="SettingsS2ApplyConfig_Click" MinHeight="28" Padding="14,3" Background="#162C42" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" ToolTip="Validate and apply explicit calibration and tray layout atomically."/>
