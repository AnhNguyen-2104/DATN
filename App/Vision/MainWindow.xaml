<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PlateVision50.MainWindow" Title="DATN | Line Control · TwinCAT Master" Width="1600" Height="940" MinWidth="1150" MinHeight="660" WindowStartupLocation="CenterScreen" Background="#0E151C" Foreground="#E3E9EF" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
    <!-- Siemens WinCC Unified SCADA Design Tokens -->
    <SolidColorBrush x:Key="ScadaBg" Color="#07121E" />
    <SolidColorBrush x:Key="ScadaNavBg" Color="#0B1B2B" />
    <SolidColorBrush x:Key="ScadaHeaderBg" Color="#101E2E" />
    <SolidColorBrush x:Key="ScadaPanelPrimary" Color="#112335" />
    <SolidColorBrush x:Key="ScadaPanelSecondary" Color="#0D1C2B" />
    <SolidColorBrush x:Key="ScadaPanelHover" Color="#162C42" />
    <SolidColorBrush x:Key="ScadaBorder" Color="#23384D" />
    <SolidColorBrush x:Key="ScadaBorderBright" Color="#30465B" />
    <SolidColorBrush x:Key="ScadaTextPrimary" Color="#E8F1FC" />
    <SolidColorBrush x:Key="ScadaTextSecondary" Color="#92AABE" />
    <SolidColorBrush x:Key="ScadaCyan" Color="#27C9EC" />
    <SolidColorBrush x:Key="ScadaTeal" Color="#39C7A2" />
    <SolidColorBrush x:Key="ScadaAmber" Color="#F4BB45" />
    <SolidColorBrush x:Key="ScadaRed" Color="#FF6E70" />
    <!-- Approved compact SCADA palette (Docs/PREVIEW_DATN_SCADA_COMPACT_APPROVED_20261021.html) -->
    <SolidColorBrush x:Key="ScadaTopBg" Color="#171F28" />
    <SolidColorBrush x:Key="ScadaVideoBg" Color="#0C131A" />
    <SolidColorBrush x:Key="ScadaPanelHead" Color="#1D2933" />
