                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="ACTUAL SPEED" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvSpeed" Text="-- mm/s" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="ENCODER POSITION" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvDistance" Text="-- mm" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                <Border BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1,0,0,0" Padding="8,3"><StackPanel><TextBlock Text="MACHINE STATE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="OvCvCommand" Text="DISARMED" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
              </UniformGrid>

              <Grid Grid.Row="2" Margin="8,5,8,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="1"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- SYSTEM: contract pending, so every button is disabled with a reason tooltip. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="SYSTEM" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button x:Name="SysStartButton" Content="START" Click="DashGlobalCommand_Click" Tag="START" IsEnabled="False" MinWidth="58" MinHeight="25" Padding="8,1" FontSize="11" ToolTip="Global START is not commissioned: no verified TwinCAT command/ack symbol exists. Disabled by design."/>
                  <Button x:Name="SysStopButton" Content="STOP" Click="DashGlobalCommand_Click" Tag="STOP" IsEnabled="False" MinWidth="58" MinHeight="25" Padding="8,1" FontSize="11" ToolTip="Global STOP is not commissioned. The physical emergency stop is the only safety-rated stop."/>
                  <Button x:Name="SysResetButton" Content="RESET" Click="DashGlobalCommand_Click" Tag="RESET" IsEnabled="False" MinWidth="58" MinHeight="25" Padding="8,1" FontSize="11" ToolTip="Fault acknowledge is not commissioned: no verified reset symbol exists in the PLC image."/>
                   <Button x:Name="OvVisionStartButton" Content="START VISION" Click="StationVisionStart_Click" MinWidth="88" MinHeight="25" Padding="6,1" FontSize="10" Margin="9,0,0,0" ToolTip="Starts camera/video detection on this PC only. Does not start conveyor or robots."/>
                   <Button x:Name="OvVisionStopButton" Content="STOP VISION" Click="StationVisionStop_Click" MinWidth="85" MinHeight="25" Padding="6,1" FontSize="10" ToolTip="Stops detection only; camera view remains live. NOT a machine stop."/>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{StaticResource ScadaBorder}" Margin="10,2"/>

                <!-- CONVEYOR MANUAL: mm/s only; no mm/s to Hz conversion is accepted yet. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="CONVEYOR" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="setpoint" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                  <TextBox x:Name="OvBeltSetpointBox" Text="100" IsEnabled="True" Width="62" MinHeight="25" Padding="5,1" FontSize="11" HorizontalContentAlignment="Right" ToolTip="mm/s setpoint is not enabled: no validated mm/s to Hz mapping exists, so no setpoint is written."/>
                  <TextBlock Text="mm/s" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                  <Button x:Name="OvBeltSetButton" Content="SET" Click="DashGlobalCommand_Click" Tag="BELT_SET" IsEnabled="False" MinWidth="48" MinHeight="25" Padding="6,1" FontSize="11" ToolTip="Disabled: mm/s to Hz conversion is not commissioned for the MD200 reference."/>
                  <Button x:Name="OvBeltStartButton" Content="START BELT" Click="DashGlobalCommand_Click" Tag="BELT_START" IsEnabled="False" MinWidth="82" MinHeight="25" Padding="6,1" FontSize="11" ToolTip="Manual belt start is locked while the automatic contract is pending."/>
                  <Button x:Name="OvBeltStopButton" Content="STOP BELT" Click="DashGlobalCommand_Click" Tag="BELT_STOP" IsEnabled="False" MinWidth="80" MinHeight="25" Padding="6,1" FontSize="11" ToolTip="Manual belt stop is locked. Use the physical emergency stop in danger."/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                   <CheckBox x:Name="OvManualModeToggle" Content="MANUAL MODE" Checked="OperatorManualModeChanged" Unchecked="OperatorManualModeChanged" FontSize="10" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="2,0,8,0" ToolTip="Default AUTO. Manual access requires explicit confirmation; it does not arm any PLC write."/>
                   <Button Content="ADVANCED / TAGS" Click="DashOpenConveyor_Click" MinWidth="118" MinHeight="25" Padding="8,1" FontSize="10" ToolTip="Read-only telemetry is available in all modes; legacy controls appear only after choosing Manual."/>
                 </StackPanel>
              </Grid>

              <Border Grid.Row="3" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,1,0,0" Padding="8,3">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="OvCvQuality" Text="NO DATA" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" x:Name="OvAlarm" Text="No PLC alarm data. Global START/STOP is not commissioned." FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="VISION COMMANDS: PC ONLY | MACHINE COMMANDS: NOT COMMISSIONED" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- Legacy dashboard data sinks: unchanged writers, never shown. -->
          <StackPanel Grid.Row="2" Visibility="Collapsed">
            <TextBlock x:Name="DashUpdated"/>
            <TextBlock x:Name="OverviewGlobalAuthority"/>
            <Image x:Name="OverviewCam1Image" Source="{Binding Source,ElementName=Preview}"/>
            <TextBlock x:Name="OverviewCam1Quality"/>
            <TextBlock x:Name="OverviewCam1Empty"/>
            <TextBlock x:Name="OverviewIoEstop"/>
            <TextBlock x:Name="OverviewIoServo"/>
            <TextBlock x:Name="OverviewIoPlcQ"/>
            <TextBlock x:Name="OverviewIoGantryBusy"/>
            <TextBlock x:Name="OverviewIoGantryAlarm"/>
            <TextBlock x:Name="OverviewIoVision"/>
            <TextBlock x:Name="OverviewIoBeltDO"/>
            <TextBlock x:Name="OverviewIoMd200Cmd"/>
            <TextBlock x:Name="OverviewIoEncoder"/>
            <TextBlock x:Name="OverviewIoAo"/>
            <TextBlock x:Name="OverviewCam1Track"/>
            <TextBlock x:Name="OverviewCam1Pose"/>
            <TextBlock x:Name="DashSpeed"/>
            <TextBlock x:Name="DashBeltState"/>
            <TextBlock x:Name="DashDistance"/>
            <TextBlock x:Name="DashBeltMmS"/>
            <TextBlock x:Name="Ov1Ready"/>
            <TextBlock x:Name="Ov1Mode"/>
            <TextBlock x:Name="Ov1Busy"/>
            <TextBlock x:Name="Ov1Homed"/>
            <TextBlock x:Name="Ov1X"/>
            <TextBlock x:Name="Ov1Y"/>
            <TextBlock x:Name="Ov1Z"/>
            <TextBlock x:Name="Ov1Rz"/>
            <TextBlock x:Name="Ov1Io1"/>
            <TextBlock x:Name="Ov1Io2"/>
            <TextBlock x:Name="Ov1Io3"/>
            <TextBlock x:Name="Ov1Io4"/>
            <TextBlock x:Name="Ov1Io5"/>
            <TextBlock x:Name="Ov1Io6"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="STATION 01" x:Name="GantryDetailTab">
        <Grid Background="{StaticResource ScadaBg}" Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2.6*" MinHeight="220"/>
            <RowDefinition Height="1*" MinHeight="130"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- A. Page header -->
          <Grid Margin="0,0,0,4" MinHeight="26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="STATION 01 · GANTRY DISPENSING" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ScadaTextPrimary}" VerticalAlignment="Center"/>
              <Border Width="1" Height="20" Background="{StaticResource ScadaBorderBright}" Margin="12,0" VerticalAlignment="Center"/>
              <TextBlock Text="GANTRY · 4-POINT GLUE DISPENSING" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaCyan}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="S1BadgeHost" Background="#103028" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,8,0" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1">
              <TextBlock x:Name="S1Badge" Text="CHECKING" Foreground="{StaticResource ScadaTeal}" FontSize="10" FontWeight="Bold"/>
            </Border>
            <Button Grid.Column="2" x:Name="S1SettingsButton" Content="STATION 01 SETTINGS" Click="StationSettings_Click" Tag="S1" MinHeight="28" Padding="12,3" FontSize="10.5"/>
          </Grid>

          <!-- B. Top band: camera (dominant) | robot telemetry | product tracking -->
          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58*" MinWidth="360"/>
              <ColumnDefinition Width="20*" MinWidth="180"/>
              <ColumnDefinition Width="22*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource ScadaPanelPrimary}" CornerRadius="5,5,0,0" Padding="10,6">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="S1CamBadge" Text="CAMERA 01 · NO FRAME" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="LIVE PIPELINE · OVERLAY PRESERVED" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/>
                  </Grid>
                </Border>
                <Grid Grid.Row="1">
                  <Image x:Name="Station1Preview" Source="{Binding Source,ElementName=Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock x:Name="S1CamEmpty" Text="Camera 1 not connected — select a source in VISION WORKSPACE" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ScadaTextSecondary}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
                  <UniformGrid VerticalAlignment="Bottom" Columns="3" Margin="8">
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4" Margin="0,0,5,0"><StackPanel><TextBlock Text="TRACK ID" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1TrackId" Text="--" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4" Margin="0,0,5,0"><StackPanel><TextBlock Text="DETECTION" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1DetectStatus" Text="OFF" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                    <Border Background="#D007121E" CornerRadius="3" Padding="7,4"><StackPanel><TextBlock Text="CONFIDENCE" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Confidence" Text="--" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource ScadaTextPrimary}"/></StackPanel></Border>
                  </UniformGrid>
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
              <StackPanel Margin="11,9">
                <TextBlock Text="ROBOT TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,6,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="Controller link" FontSize="10.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                  <TextBlock Grid.Column="1" x:Name="S1Link" Text="NO DATA" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Row="1" Text="Robot ready" FontSize="10.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,5,0,0"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="S1Ready" Text="NO DATA" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                  <TextBlock Grid.Row="2" Text="Servo state" FontSize="10.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,5,0,0"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S1Servo" Text="NO DATA" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                  <TextBlock Grid.Row="3" Text="Robot mode" FontSize="10.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,5,0,0"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="S1Mode" Text="NO DATA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" HorizontalAlignment="Right" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="4" Text="Busy / fault" FontSize="10.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,5,0,0"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" x:Name="S1Busy" Text="NO DATA" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                  <TextBlock Grid.Row="5" Text="Homed / referenced" FontSize="10.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,5,0,0"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" x:Name="S1Homed" Text="NO DATA" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextSecondary}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </Grid>
                <Border Background="{StaticResource ScadaPanelSecondary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="4" Padding="9,6" Margin="0,9,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="ACTUAL ROBOT TCP" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaTextSecondary}"/>
                      
                    </Grid>
                    <UniformGrid Columns="4" Margin="0,5,0,0">
                      <StackPanel><TextBlock Text="X" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1X" Text="--" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                      <StackPanel><TextBlock Text="Y" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Y" Text="--" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                      <StackPanel><TextBlock Text="Z" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Z" Text="--" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                      <StackPanel><TextBlock Text="Rz" FontSize="9" Foreground="{StaticResource ScadaTextSecondary}"/><TextBlock x:Name="S1Rz" Text="--" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource ScadaAmber}"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Text="TCP: NOT AVAILABLE IN PLC IMAGE" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaAmber}" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
              <StackPanel Margin="11,9">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="PRODUCT TRACKING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                  <Border Grid.Column="1" Background="#103028" CornerRadius="3" Padding="6,2">
                    <TextBlock x:Name="S1QualityChip" Text="READ ONLY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource ScadaTeal}"/>
                  </Border>
                </Grid>
                <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,6,0,7"/>
                <TextBlock Text="Vision pose (not robot TCP)" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}"/>
                <TextBlock x:Name="S1Pose" Text="X --   Y --   θ --" FontSize="14" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" Margin="0,2,0,0"/>
                <TextBlock x:Name="S1FrameQuality" Text="Frame quality: --" FontSize="9.5" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,2,0,0"/>
                <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="Queue" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}"/>
                  <TextBlock Grid.Column="1" x:Name="S1QueueDepth" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Row="1" Text="Cycle" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="S1CycleStatus" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="2" Text="4-point sequence" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S1Vertex" Text="NO DATA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </Grid>
                <TextBlock Text="Camera pose is a measurement of the product; it never becomes a robot TCP value." FontSize="8.5" Foreground="{StaticResource ScadaTextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Border Height="1" Background="{StaticResource ScadaBorder}" Margin="0,8,0,7"/>
                <TextBlock Text="STATION CONFIGURATION" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource ScadaCyan}"/>
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="Station role" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}"/>
                  <TextBlock Grid.Column="1" Text="Gantry glue" FontSize="10" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Row="1" Text="Glue points" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="4 corners" FontSize="10" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="2" Text="Camera" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="S1CfgCamera" Text="Camera 1" FontSize="10" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="3" Text="Handshake" FontSize="10" Foreground="{StaticResource ScadaTextSecondary}" Margin="0,4,0,0"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="PLC-Q FIFO" FontSize="10" Foreground="{StaticResource ScadaTextPrimary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </Grid>
              </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- C. Lower pane: Sensors &amp; I/O | Parameters | Local Events (functional tabs) -->
          <Border Grid.Row="2" Background="{StaticResource ScadaPanelPrimary}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
            <TabControl Background="Transparent" BorderThickness="0" Padding="0">
              <TabControl.Resources>
                <Style TargetType="TabItem">
                  <Setter Property="FontSize" Value="11"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Foreground" Value="{StaticResource ScadaTextSecondary}"/>
                  <Setter Property="Margin" Value="0,0,4,0"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="TabItem">
                        <Border x:Name="ti" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,7">
                          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ti" Property="BorderBrush" Value="{StaticResource ScadaCyan}"/>
                            <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}"/>
                          </Trigger>
                          <MultiTrigger>
                            <MultiTrigger.Conditions>
                              <Condition Property="IsMouseOver" Value="True"/>
                              <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}"/>
                          </MultiTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </TabControl.Resources>

              <TabItem Header="SENSORS &amp; I/O">
                <Grid Margin="10,8,10,8">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                      <Button Content="ALL" Tag="S1|ALL" Click="StationSensorGroup_Click" FontSize="10" Padding="9,2" MinHeight="24" Margin="0,0,4,0"/>
                      <Button Content="SAFETY" Tag="S1|SAFETY" Click="StationSensorGroup_Click" FontSize="10" Padding="9,2" MinHeight="24" Margin="0,0,4,0"/>
                      <Button Content="MOTION" Tag="S1|MOTION" Click="StationSensorGroup_Click" FontSize="10" Padding="9,2" MinHeight="24" Margin="0,0,4,0"/>
                      <Button Content="VISION" Tag="S1|VISION" Click="StationSensorGroup_Click" FontSize="10" Padding="9,2" MinHeight="24" Margin="0,0,4,0"/>
