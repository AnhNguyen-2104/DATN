                  <Button Content="SCAN CAMERAS" Click="ScanCameras_Click" Background="{DynamicResource VDTheme028}" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
                  <ComboBox x:Name="CameraPicker" Width="260" DisplayMemberPath="Name" />
                  <Button Content="CONNECT" Click="ConnectCamera_Click" MinHeight="30" Foreground="{DynamicResource VDTheme025}" />
                  <Button Content="CONNECT ALL" Click="ConnectAll_Click" Background="{DynamicResource VDTheme028}" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
                </WrapPanel>
                <WrapPanel Margin="0,4,0,6">
                  <TextBlock Text="IP camera" Foreground="{DynamicResource VDTheme059}" VerticalAlignment="Center" Margin="7,0,0,0" />
                  <TextBox x:Name="CameraIpBox" Width="174" Text="169.254.113.1" ToolTip="Hikrobot GigE Vision IPv4 address" />
                  <TextBlock Text="IP PC" Foreground="{DynamicResource VDTheme059}" VerticalAlignment="Center" />
                  <TextBox x:Name="HostIpBox" Width="174" Text="169.254.113.10" ToolTip="Ethernet 2 IPv4 on the camera subnet" />
                  <Button Content="CONNECT IP" Click="ConnectCameraIp_Click" Background="{DynamicResource VDTheme060}" ToolTip="Connect via Hikrobot SDK without MVS scanning" MinHeight="30" Foreground="{DynamicResource VDTheme025}" />
                </WrapPanel>
                <TextBlock Text="Example: camera 169.254.113.1, Ethernet 2: 169.254.113.10. Connecting opens Live View only." Foreground="{DynamicResource VDTheme061}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="0" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Video Source / Testing" Style="{StaticResource SectionHeading}" FontSize="14" />
                <TextBlock Text="Select an offline video to test the detection algorithm without real products." Foreground="{DynamicResource VDTheme058}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                <WrapPanel Margin="0,4,0,6">
                  <ComboBox x:Name="VideoPicker" Width="260" DisplayMemberPath="Name" />
                  <Button Content="PLAY VIDEO" Click="OpenDemo_Click" MinHeight="30" Foreground="{DynamicResource VDTheme025}" />
                  <Button Content="OPEN FILE..." Click="OpenFile_Click" Background="{DynamicResource VDTheme028}" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
                  <Button Content="PAUSE VIDEO" Click="Pause_Click" Background="{DynamicResource VDTheme028}" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
                </WrapPanel>
                <TextBlock Text="Demo video has no physical encoder synchronization. Start detection from the Operation tab." Foreground="{DynamicResource VDTheme062}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="0" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Connection Information" Style="{StaticResource SectionHeading}" FontSize="14" />
                <TextBlock Text="Camera source status and guidance appear in the bottom status bar." Foreground="{DynamicResource VDTheme058}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Content="GO TO OPERATION" Click="OpenMonitorPage_Click" Background="{DynamicResource VDTheme028}" HorizontalAlignment="Left" MinHeight="30" Foreground="{DynamicResource VDTheme029}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      </TabControl>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource ScadaTopBg}" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="0,1,0,0" Padding="10,0">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Start with an offline video demo; never command PLC motion from this view." Foreground="{StaticResource ScadaTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="HMI FEEDBACK IS NOT A CERTIFIED SAFETY FUNCTION" Foreground="{StaticResource ScadaAmber}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>