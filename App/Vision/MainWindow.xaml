                        </StackPanel>
                        <Border Grid.Column="1" Background="#0C1B2A" BorderBrush="#23384D" BorderThickness="1" CornerRadius="3" Padding="8,4" VerticalAlignment="Center" Margin="10,0,0,0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="STATUS: " FontSize="9.5" FontWeight="SemiBold" Foreground="#92AABE" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsS2CamLinkText" Text="OFFLINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ScadaAmber}" VerticalAlignment="Center"/>
                          </StackPanel>
