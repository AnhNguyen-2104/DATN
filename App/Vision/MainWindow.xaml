  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel Margin="0,0,0,0">
          <TextBlock Text="DATN / LINE CONTROL" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource VDTheme013}" />
          <TextBlock Text="GANTRY DISPENSING  ·  SCARA PICK-PLACE  ·  CONVEYOR TRACKING" Foreground="{DynamicResource VDTheme014}" FontSize="11" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="SOURCE  /  TRACKING  /  PLC" Foreground="{DynamicResource VDTheme015}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
        <TextBlock x:Name="ControlSafetyBanner" Text="ADS: READ-ONLY BY DEFAULT  |  ROBOT: NO COMMANDS" Foreground="{DynamicResource VDTheme016}" FontSize="11" HorizontalAlignment="Right" />
        <CheckBox x:Name="DarkModeBox" Content="Dark theme" Checked="DarkModeChanged" Unchecked="DarkModeChanged" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VDTheme017}" HorizontalAlignment="Right" Margin="0,3,0,0" />
      </StackPanel>
    </Grid>
    <TabControl x:Name="MainNavigation" Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource VDTheme018}" BorderThickness="0" Margin="0,3,0,2" SelectedIndex="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="MinWidth" Value="162" />
          <Setter Property="Padding" Value="13,10" />
          <Setter Property="Margin" Value="0,0,7,1" />
          <Setter Property="Foreground" Value="{DynamicResource VDTheme019}" />
          <Setter Property="Background" Value="{DynamicResource VDTheme020}" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="Normal" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border Background="{TemplateBinding Background}" CornerRadius="0" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource VDTheme021}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VDTheme022}" />
                    <Setter Property="Foreground" Value="{DynamicResource VDTheme023}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem Header="OVERVIEW" x:Name="DashboardTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#0B1723">
          <StackPanel Margin="18,15,18,20">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="PRODUCTION LINE OVERVIEW" FontSize="19" FontWeight="Bold" Foreground="#EDF5FA"/>
                <TextBlock Text="DATN   /   TwinCAT 3 MASTER   /   Gantry · Conveyor · SCARA" FontSize="11" Foreground="#87A0B7" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="DashUpdated" Text="Reading PLC..." FontSize="11" Foreground="#A1B6C5" HorizontalAlignment="Right"/>
                <TextBlock Text="ADS 851 monitoring · No automatic robot commands" FontSize="11" Foreground="#63BDCF" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <!-- Global dashboard controls are deliberately request-only until the PLC safety contract is commissioned. -->
            <Border Background="#172A3A" BorderBrush="#456077" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="GLOBAL COMMANDS / NOT COMMISSIONED" FontSize="13" FontWeight="Bold" Foreground="#E6F4FD"/>
                  <TextBlock x:Name="OverviewGlobalAuthority" Text="Global Start/Stop handshake not commissioned · Buttons show information only" FontSize="11" Foreground="#F4D18D" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                  <Button Content="GLOBAL START · NOT WIRED" Tag="START" Click="DashGlobalCommand_Click" MinWidth="155" MinHeight="34" Margin="0,0,7,0" Background="#1D726A" Foreground="White" ToolTip="Global START handshake is not connected. Click for integration requirements; no ADS write."/>
                  <Button Content="GLOBAL STOP · NOT WIRED" Tag="STOP" Click="DashGlobalCommand_Click" MinWidth="150" MinHeight="34" Margin="0,0,7,0" Background="#A36C35" Foreground="White" ToolTip="Global STOP handshake is not commissioned. Click for details; no ADS write."/>
                  <Button Content="E-STOP / SAFETY INFO" Tag="ESTOP" Click="DashGlobalCommand_Click" MinWidth="147" MinHeight="34" Background="#953C45" Foreground="White" FontWeight="Bold" ToolTip="Information only. A physical emergency-stop circuit must stop the machinery independently of the HMI."/>
                </WrapPanel>
              </Grid>
            </Border>
            <TextBlock Text="STATION 01 / GANTRY    —    STATION 02 / SCARA" Foreground="#D6E5ED" FontSize="12" FontWeight="Bold" Margin="0,0,0,9"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#132639" BorderBrush="#2D546C" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0" Padding="11">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="01 / GANTRY DISPENSING" Foreground="#62CEE5" FontSize="11" FontWeight="Bold"/><TextBlock Text="4-POINT GLUE DISPENSING" Foreground="#F3F8FC" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                    <Border Grid.Column="1" Background="#183E4A" CornerRadius="3" Padding="9,5"><TextBlock Text="PHASE 1" Foreground="#79D9D4" FontSize="10" FontWeight="Bold"/></Border>
                  </Grid>
                  <Separator Background="#3D5668" Margin="0,13,0,11"/>
                  <!-- Same WPF bitmap from Camera 1 operating view, not a second camera SDK session. -->
                  <Border Height="280" Background="#071420" BorderBrush="#37556B" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <Grid>
                      <Image x:Name="OverviewCam1Image" Source="{Binding Source,ElementName=Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#B9091A2A" Padding="7,4" Margin="8">
                        <TextBlock x:Name="OverviewCam1Quality" Text="CAMERA 1 / NO FRAME" Foreground="#DAEEF7" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock x:Name="OverviewCam1Empty" Text="Camera 1 disconnected / Open Camera Source to connect" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A5BDCD" TextWrapping="Wrap" TextAlignment="Center" Margin="18" FontSize="12"/>
                    </Grid>
                  </Border>
                  <Border Background="#0A1B28" BorderBrush="#315569" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,6">
                    <StackPanel>
                      <TextBlock Text="STATION 01  /  LIVE I/O AND PLC SIGNALS" Foreground="#75C6D8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                      <UniformGrid Columns="3" Rows="2">
                        <TextBlock x:Name="OverviewIoEstop" Text="ST-1228 DI0  |  UNKNOWN" Foreground="#E3CF9A" FontSize="11" Margin="3,4" ToolTip="Auxiliary E-Stop input feedback, NOT a certified safety circuit"/>
                        <TextBlock x:Name="OverviewIoServo" Text="SERVO READY  |  UNKNOWN" Foreground="#E3CF9A" FontSize="11" Margin="3,4"/>
                        <TextBlock x:Name="OverviewIoPlcQ" Text="PLC-Q LINK  |  UNKNOWN" Foreground="#E3CF9A" FontSize="11" Margin="3,4"/>
                        <TextBlock x:Name="OverviewIoGantryBusy" Text="GANTRY BUSY  |  UNKNOWN" Foreground="#E3CF9A" FontSize="11" Margin="3,4"/>
                        <TextBlock x:Name="OverviewIoGantryAlarm" Text="GANTRY ALARM  |  UNKNOWN" Foreground="#E3CF9A" FontSize="11" Margin="3,4"/>
                        <TextBlock x:Name="OverviewIoVision" Text="VISION BRIDGE  |  UNKNOWN" Foreground="#E3CF9A" FontSize="11" Margin="3,4"/>
                      </UniformGrid>
                    </StackPanel>
                  </Border>
                  <Grid Margin="0,9,0,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="TRACKED PRODUCT" Foreground="#8EADBF" FontSize="10"/>
                      <TextBlock x:Name="OverviewCam1Track" Text="Track ID: --" Foreground="#F1F8FC" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="IMAGE POSITION / mm · θ" Foreground="#8EADBF" FontSize="10"/>
                      <TextBlock x:Name="OverviewCam1Pose" Text="X --  Y --  θ --" Foreground="#F1F8FC" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="CAMERA 1 / PRODUCT TRACKING EVENTS" Foreground="#88BDCD" FontSize="10" FontWeight="Bold" Margin="0,1,0,5"/>
                  <DataGrid x:Name="OverviewGantryLog" Height="92" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="None" Background="#102738" Foreground="#E6F2FB" RowBackground="#102738" AlternatingRowBackground="#203C4B" BorderThickness="0" RowHeight="27" CanUserAddRows="False">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="75"/>
                      <DataGridTextColumn Header="Track" Binding="{Binding TrackId}" Width="44"/>
                      <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="135"/>
                      <DataGridTextColumn Header="Event" Binding="{Binding Delivery}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock x:Name="OverviewGantrySensors" Text="I/O / waiting for PLC..." TextWrapping="Wrap" Foreground="#9DC7CF" FontSize="11" Margin="0,9,0,7"/>

                  <TextBlock x:Name="DashGantryState" Text="Robot: reading status..." Foreground="#E9F0F5" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock x:Name="DashGantryPlc" Text="Mitsubishi QD75: —" Foreground="#ADC0CE" Margin="0,6,0,0"/>
                  <TextBlock x:Name="DashGantryVertex" Text="Current vertex: — / 4" Foreground="#ADC0CE" Margin="0,5,0,0"/>
                  <TextBlock x:Name="DashCamera1" Text="Camera 1: —" Foreground="#ADC0CE" Margin="0,5,0,0"/>
                  <TextBlock x:Name="DashGantryStats" Text="FIFO: — | Accepted: — | Missed: —" Foreground="#ADC0CE" Margin="0,5,0,9"/>
                  <WrapPanel Margin="0,7,0,0">
                    <Button Content="OPEN STATION 01 DETAILS" Click="DashOpenGantry_Click" Background="#236F8C" Foreground="White" MinHeight="32" Margin="0,0,7,0"/>
                    <Button Content="PLC STATUS" Click="DashPLC_Click" Background="#294053" Foreground="#EDF6FA" MinHeight="32"/>
                  </WrapPanel>
                  <TextBlock Text="Robot motion disabled from HMI. M1000/M1001 remain PLC-Q-controlled." TextWrapping="Wrap" Foreground="#8EA5B6" FontSize="10" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#142330" BorderBrush="#33485C" BorderThickness="1" CornerRadius="8" Padding="11">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="02 / SCARA PICK &amp; PLACE" Foreground="#B0C1D0" FontSize="11" FontWeight="Bold"/><TextBlock Text="TRAY PICK AND PLACE" Foreground="#E6EFF5" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                    <Border Grid.Column="1" Background="#35414C" CornerRadius="3" Padding="9,5"><TextBlock Text="PLANNED" Foreground="#E3D3A0" FontSize="10" FontWeight="Bold"/></Border>
                  </Grid>
                  <Separator Background="#3D5668" Margin="0,13,0,11"/>
                  <Border Height="280" Background="#091520" BorderBrush="#37556B" BorderThickness="1" CornerRadius="4">
                    <Grid>
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="CAMERA 02" FontSize="18" FontWeight="Bold" Foreground="#7B96A8" HorizontalAlignment="Center"/>
                        <TextBlock Text="NOT CONNECTED / NOT COMMISSIONED" FontSize="11" Foreground="#E4BB78" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="No simulated camera or pose values are shown as live data" FontSize="10" Foreground="#93A7B8" Margin="0,9,0,0" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Background="#0E1E2B" BorderBrush="#334455" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,6">
                    <StackPanel>
                      <TextBlock Text="STATION 02  /  I/O NOT COMMISSIONED" Foreground="#DABF8B" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                      <UniformGrid Columns="3" Rows="2">
                        <TextBlock Text="CAMERA 2  |  NOT INSTALLED" Foreground="#9AA9B7" FontSize="11" Margin="3,4"/>
                        <TextBlock Text="ROBOT READY  |  UNMAPPED" Foreground="#9AA9B7" FontSize="11" Margin="3,4"/>
                        <TextBlock Text="GRIPPER  |  UNMAPPED" Foreground="#9AA9B7" FontSize="11" Margin="3,4"/>
                        <TextBlock Text="TRAY SENSOR  |  UNMAPPED" Foreground="#9AA9B7" FontSize="11" Margin="3,4"/>
                        <TextBlock Text="SCARA ALARM  |  UNMAPPED" Foreground="#9AA9B7" FontSize="11" Margin="3,4"/>
                        <TextBlock Text="QUEUE ACK  |  UNMAPPED" Foreground="#9AA9B7" FontSize="11" Margin="3,4"/>
                      </UniformGrid>
                    </StackPanel>
                  </Border>
                  <Grid Margin="0,9,0,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="TRACK / TRAY" Foreground="#8EADBF" FontSize="10"/><TextBlock Text="-- / RESERVED" Foreground="#E4D5AA" FontSize="13" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="X / Y / θ" Foreground="#8EADBF" FontSize="10"/><TextBlock Text="-- / -- / --" Foreground="#E4D5AA" FontSize="13" Margin="0,4,0,0"/></StackPanel>
                  </Grid>
                  <Border Height="92" Background="#102330" BorderBrush="#253C4F" BorderThickness="1" Padding="10">
                    <StackPanel><TextBlock Text="LOG SCARA" Foreground="#8BB1C2" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="No robot, sensor or product data available at Station 02." TextWrapping="Wrap" Foreground="#9BB1C0" FontSize="11" Margin="0,8,0,0"/></StackPanel>
                  </Border>
                  <TextBlock Text="I/O / Camera 2, robot ready and tray: NOT COMMISSIONED" Foreground="#A3AEB9" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,7"/>

                  <TextBlock Text="SCARA PLC: NOT COMMISSIONED" Foreground="#E3D3A0" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="Camera 2: not installed" Foreground="#ADC0CE" Margin="0,7,0,0"/>
                  <TextBlock Text="Tracking: shared conveyor encoder" Foreground="#ADC0CE" Margin="0,5,0,0"/>
