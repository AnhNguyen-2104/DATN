  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel Margin="0,0,0,0">
          <TextBlock Text="DATN / LINE CONTROL" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource VDTheme013}" />
          <TextBlock Text="GANTRY DISPENSING  ·  SCARA PICK-PLACE  ·  CONVEYOR TRACKING" Foreground="{DynamicResource VDTheme014}" FontSize="11" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="NGUỒN  /  TRACKING  /  PLC" Foreground="{DynamicResource VDTheme015}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
        <TextBlock x:Name="ControlSafetyBanner" Text="ADS: CHỈ ĐỌC MẶC ĐỊNH  |  ROBOT: KHÔNG ĐIỀU KHIỂN" Foreground="{DynamicResource VDTheme016}" FontSize="11" HorizontalAlignment="Right" />
        <CheckBox x:Name="DarkModeBox" Content="Giao diện tối" Checked="DarkModeChanged" Unchecked="DarkModeChanged" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VDTheme017}" HorizontalAlignment="Right" Margin="0,3,0,0" />
      </StackPanel>
    </Grid>
    <TabControl x:Name="MainNavigation" Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource VDTheme018}" BorderThickness="0" Margin="0,3,0,2" SelectedIndex="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="MinWidth" Value="162" />
          <Setter Property="Padding" Value="13,10" />
          <Setter Property="Margin" Value="0,0,7,1" />
          <Setter Property="Foreground" Value="{DynamicResource VDTheme019}" />
          <Setter Property="Background" Value="{DynamicResource VDTheme020}" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="Normal" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border Background="{TemplateBinding Background}" CornerRadius="0" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource VDTheme021}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VDTheme022}" />
                    <Setter Property="Foreground" Value="{DynamicResource VDTheme023}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem Header="TỔNG QUAN" x:Name="DashboardTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#0B1723">
          <StackPanel Margin="18,15,18,20">
            <Grid Margin="0,0,0,13">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="TRUNG TÂM ĐIỀU KHIỂN DÂY CHUYỀN" FontSize="23" FontWeight="Bold" Foreground="#EDF5FA"/>
                <TextBlock Text="DATN   /   TwinCAT 3 MASTER   /   Gantry · Conveyor · SCARA" FontSize="11" Foreground="#87A0B7" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="DashUpdated" Text="Đang đọc PLC..." FontSize="11" Foreground="#A1B6C5" HorizontalAlignment="Right"/>
                <TextBlock Text="Giám sát ADS 851 · không tự phát lệnh robot" FontSize="11" Foreground="#63BDCF" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <!-- Global dashboard controls are deliberately request-only until the PLC safety contract is commissioned. -->
            <Border Background="#172A3A" BorderBrush="#456077" BorderThickness="1" CornerRadius="7" Padding="12,10" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="ĐIỀU KHIỂN TỔNG / LINE COMMAND" FontSize="13" FontWeight="Bold" Foreground="#E6F4FD"/>
                  <TextBlock x:Name="OverviewGlobalAuthority" Text="CHƯA NGHIỆM THU LỆNH TOÀN DÂY CHUYỀN · CÁC NÚT CHỈ HIỂN THỊ HƯỚNG DẪN" FontSize="11" Foreground="#F4D18D" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                  <Button Content="START TỔNG · CHỜ PLC" Tag="START" Click="DashGlobalCommand_Click" MinWidth="155" MinHeight="41" Margin="0,0,7,0" Background="#1D726A" Foreground="White" ToolTip="Chưa kết nối handshake START tổng; click để xem yêu cầu tích hợp, không gửi ADS."/>
                  <Button Content="STOP TỔNG · CHỜ PLC" Tag="STOP" Click="DashGlobalCommand_Click" MinWidth="150" MinHeight="41" Margin="0,0,7,0" Background="#A36C35" Foreground="White" ToolTip="Chưa có lệnh STOP tổng được nghiệm thu; click để xem thông tin, không gửi ADS."/>
                  <Button Content="E-STOP / HƯỚNG DẪN" Tag="ESTOP" Click="DashGlobalCommand_Click" MinWidth="147" MinHeight="41" Background="#953C45" Foreground="White" FontWeight="Bold" ToolTip="Chỉ hiển thị hướng dẫn. Mạch E-Stop vật lý phải dừng thiết bị độc lập với HMI."/>
                </WrapPanel>
              </Grid>
            </Border>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#142739" BorderBrush="#274158" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="HỆ THỐNG / E-STOP" FontSize="10" Foreground="#92A8BA"/><TextBlock x:Name="DashEStop" Text="CHƯA XÁC NHẬN" FontSize="18" FontWeight="Bold" Foreground="#EAC17E" Margin="0,9,0,4"/><TextBlock Text="Phản hồi ST-1228 · DI0" FontSize="10" Foreground="#91A2B3"/></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#142739" BorderBrush="#274158" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="TWINCAT / PLC" FontSize="10" Foreground="#92A8BA"/><TextBlock x:Name="DashPlc" Text="ĐANG KẾT NỐI" FontSize="18" FontWeight="Bold" Foreground="#EAC17E" Margin="0,9,0,4"/><TextBlock Text="ADS port 851 · MASTER" FontSize="10" Foreground="#91A2B3"/></StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#142739" BorderBrush="#274158" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="BĂNG TẢI DÙNG CHUNG" FontSize="10" Foreground="#92A8BA"/><TextBlock x:Name="DashSpeed" Text="— mm/s" FontSize="18" FontWeight="Bold" Foreground="#E5F2FA" Margin="0,9,0,4"/><TextBlock x:Name="DashFrequency" Text="Đặt: — Hz" FontSize="10" Foreground="#91A2B3"/></StackPanel>
              </Border>
              <Border Grid.Column="3" Background="#142739" BorderBrush="#274158" BorderThickness="1" CornerRadius="7" Padding="13">
                <StackPanel><TextBlock Text="HÀNG ĐỢI SẢN PHẨM" FontSize="10" Foreground="#92A8BA"/><TextBlock x:Name="DashQueue" Text="— / 8" FontSize="18" FontWeight="Bold" Foreground="#E5F2FA" Margin="0,9,0,4"/><TextBlock x:Name="DashQueueInfo" Text="Đang chờ PLC..." FontSize="10" Foreground="#91A2B3"/></StackPanel>
              </Border>
            </Grid>
            <Border Background="#1C2B35" CornerRadius="6" Padding="12,10" Margin="0,0,0,14" BorderBrush="#375065" BorderThickness="1">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DashMachineMessage" Text="Trạng thái toàn hệ thống đang được đọc qua ADS..." Foreground="#E3EAF0" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="HMI / THÔNG TIN VẬN HÀNH" Foreground="#8DA9B8" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <TextBlock Text="TRẠM 01 / GANTRY  —  TRẠM 02 / SCARA" Foreground="#D6E5ED" FontSize="12" FontWeight="Bold" Margin="0,0,0,9"/>
            <Grid Margin="0,0,0,15">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#132639" BorderBrush="#2D546C" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0" Padding="16">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="01 / GANTRY DISPENSING" Foreground="#62CEE5" FontSize="11" FontWeight="Bold"/><TextBlock Text="Chấm keo 4 điểm" Foreground="#F3F8FC" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                    <Border Grid.Column="1" Background="#183E4A" CornerRadius="3" Padding="9,5"><TextBlock Text="GIAI ĐOẠN 1" Foreground="#79D9D4" FontSize="10" FontWeight="Bold"/></Border>
                  </Grid>
                  <Separator Background="#3D5668" Margin="0,13,0,11"/>
                  <!-- Same WPF bitmap from Camera 1 operating view, not a second camera SDK session. -->
                  <Border Height="192" Background="#071420" BorderBrush="#37556B" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <Grid>
                      <Image x:Name="OverviewCam1Image" Source="{Binding Source,ElementName=Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#B9091A2A" Padding="7,4" Margin="8">
                        <TextBlock x:Name="OverviewCam1Quality" Text="CAMERA 1 / KHÔNG CÓ FRAME" Foreground="#DAEEF7" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock x:Name="OverviewCam1Empty" Text="Chưa có nguồn Camera 1 / Xem tab Camera để kết nối" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A5BDCD" TextWrapping="Wrap" TextAlignment="Center" Margin="18" FontSize="12"/>
                    </Grid>
                  </Border>
                  <Grid Margin="0,9,0,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="SẢN PHẨM ĐANG THEO DÕI" Foreground="#8EADBF" FontSize="10"/>
                      <TextBlock x:Name="OverviewCam1Track" Text="Track ID: --" Foreground="#F1F8FC" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="TỌA ĐỘ ẢNH / mm · θ" Foreground="#8EADBF" FontSize="10"/>
                      <TextBlock x:Name="OverviewCam1Pose" Text="X --  Y --  θ --" Foreground="#F1F8FC" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="LỊCH SỬ VẬT / TRIGGER CAMERA 1 (từ tracking C#)" Foreground="#88BDCD" FontSize="10" FontWeight="Bold" Margin="0,1,0,5"/>
                  <DataGrid x:Name="OverviewGantryLog" Height="92" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="None" Background="#102738" Foreground="#E6F2FB" RowBackground="#102738" AlternatingRowBackground="#203C4B" BorderThickness="0" RowHeight="27" CanUserAddRows="False">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Giờ" Binding="{Binding Time}" Width="75"/>
                      <DataGridTextColumn Header="Track" Binding="{Binding TrackId}" Width="44"/>
                      <DataGridTextColumn Header="Tọa độ" Binding="{Binding Position}" Width="135"/>
                      <DataGridTextColumn Header="Sự kiện" Binding="{Binding Delivery}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock x:Name="OverviewGantrySensors" Text="SENSORS / chờ PLC..." TextWrapping="Wrap" Foreground="#9DC7CF" FontSize="11" Margin="0,9,0,7"/>

                  <TextBlock x:Name="DashGantryState" Text="Robot: đang đọc..." Foreground="#E9F0F5" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock x:Name="DashGantryPlc" Text="Mitsubishi QD75: —" Foreground="#ADC0CE" Margin="0,6,0,0"/>
                  <TextBlock x:Name="DashGantryVertex" Text="Đỉnh hiện tại: — / 4" Foreground="#ADC0CE" Margin="0,5,0,0"/>
                  <TextBlock x:Name="DashCamera1" Text="Camera 1: —" Foreground="#ADC0CE" Margin="0,5,0,0"/>
                  <TextBlock x:Name="DashGantryStats" Text="FIFO: — | Hoàn thành: — | Bỏ lỡ: —" Foreground="#ADC0CE" Margin="0,5,0,9"/>
                  <WrapPanel Margin="0,7,0,0">
                    <Button Content="MỞ TRẠM 01 / ĐIỀU KHIỂN" Click="DashOpenGantry_Click" Background="#236F8C" Foreground="White" MinHeight="32" Margin="0,0,7,0"/>
                    <Button Content="TRẠNG THÁI PLC" Click="DashPLC_Click" Background="#294053" Foreground="#EDF6FA" MinHeight="32"/>
