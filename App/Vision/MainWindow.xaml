                  <Border Background="#112335" BorderBrush="#23384D" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel>
                      <TextBlock Text="CONVEYOR / ENCODER" FontSize="12" FontWeight="Bold" Foreground="#27C9EC"/>
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Tracking source" FontSize="10" Foreground="#92AABE" Margin="0,0,0,5"/>
