<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PlateVision50.MainWindow" Title="DATN | Line Control · TwinCAT Master" Width="1600" Height="940" MinWidth="1150" MinHeight="660" WindowStartupLocation="CenterScreen" Background="#0E151C" Foreground="#E3E9EF" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
    <!-- Siemens WinCC Unified SCADA Design Tokens -->
    <SolidColorBrush x:Key="ScadaBg" Color="#07121E" />
    <SolidColorBrush x:Key="ScadaNavBg" Color="#0B1B2B" />
    <SolidColorBrush x:Key="ScadaHeaderBg" Color="#101E2E" />
    <SolidColorBrush x:Key="ScadaPanelPrimary" Color="#112335" />
    <SolidColorBrush x:Key="ScadaPanelSecondary" Color="#0D1C2B" />
    <SolidColorBrush x:Key="ScadaPanelHover" Color="#162C42" />
    <SolidColorBrush x:Key="ScadaBorder" Color="#23384D" />
    <SolidColorBrush x:Key="ScadaBorderBright" Color="#30465B" />
    <SolidColorBrush x:Key="ScadaTextPrimary" Color="#E8F1FC" />
    <SolidColorBrush x:Key="ScadaTextSecondary" Color="#92AABE" />
    <SolidColorBrush x:Key="ScadaCyan" Color="#27C9EC" />
    <SolidColorBrush x:Key="ScadaTeal" Color="#39C7A2" />
    <SolidColorBrush x:Key="ScadaAmber" Color="#F4BB45" />
    <SolidColorBrush x:Key="ScadaRed" Color="#FF6E70" />
    <!-- Approved compact SCADA palette (Docs/PREVIEW_DATN_SCADA_COMPACT_APPROVED_20261021.html) -->
    <SolidColorBrush x:Key="ScadaTopBg" Color="#171F28" />
    <SolidColorBrush x:Key="ScadaVideoBg" Color="#0C131A" />
    <SolidColorBrush x:Key="ScadaPanelHead" Color="#1D2933" />
    <SolidColorBrush x:Key="ScadaBtn" Color="#2B3641" />
    <SolidColorBrush x:Key="ScadaBtnHover" Color="#394653" />
    <SolidColorBrush x:Key="ScadaInkLight" Color="#CBD7E1" />

    <!-- Dark SCADA scrollbars: WPF default is light and breaks the operator theme. -->
    <Style x:Key="ScadaScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="#3A5470" CornerRadius="4" Margin="2,0"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScadaScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{StaticResource ScadaPanelSecondary}"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{StaticResource ScadaPanelSecondary}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScadaScrollPage}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScadaScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScadaScrollPage}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <SolidColorBrush x:Key="Panel" Color="#112335" />
    <SolidColorBrush x:Key="Field" Color="#0D1C2B" />
    <SolidColorBrush x:Key="Stroke" Color="#23384D" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource ScadaBtn}" />
      <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource ScadaBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource ScadaBtnHover}" />
                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource ScadaBorderBright}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource ScadaPanelSecondary}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource ScadaPanelSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}" />
      <Setter Property="CaretBrush" Value="{StaticResource ScadaCyan}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource ScadaBorder}" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#0D1C2B" />
      <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="itemBorder" Property="Background" Value="#162C42" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="itemBorder" Property="Background" Value="#203246" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource ScadaPanelSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource ScadaTextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource ScadaBorder}" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Margin="5,0,2,0" VerticalAlignment="Center"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                <Path Grid.Column="1" Data="M0,0 L8,0 L4,5 Z" Fill="{TemplateBinding Foreground}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                <Border Background="#0D1C2B" BorderBrush="{StaticResource ScadaBorder}" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                  <ScrollViewer>
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource ScadaCyan}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource ScadaTextSecondary}" />
      <Setter Property="Margin" Value="2,4,0,2" />
    </Style>
