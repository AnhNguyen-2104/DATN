					<Name>PLC1 Instance</Name>
					<CLSID ClassFactory="TcPlc30">{08500001-0000-0000-F000-000000000064}</CLSID>
					<Vars VarGrpType="1">
						<Name>PlcTask Inputs</Name>
						<Var>
							<Name>GVL_MD200_IO.bEStopFeedback</Name>
							<Comment><![CDATA[ E-stop circuit HEALTHY auxiliary contact feedback.
 REVIEW BEFORE ACTIVATION: maps ST-1228 SLOT 6 / DI0 (physical terminal 0).
 This is a PROPOSED wiring channel, not confirmed by cabinet visual inspection.
 It must be wired to the healthy auxiliary feedback of an independent
 hardwired emergency-stop safety circuit. TRUE = safety chain healthy.
 This input alone is NOT an emergency-stop device.]]></Comment>
							<Type>BOOL</Type>
						</Var>
						<Var>
							<Name>GVL.aIn</Name>
							<Comment><![CDATA[ TxPDO 16 byte]]></Comment>
							<Type GUID="{9FC64FD6-2F79-DDE1-36AE-D3E654C53F16}">ARRAY [0..15] OF BYTE</Type>
						</Var>
					</Vars>
					<Vars VarGrpType="2" AreaNo="1">
						<Name>PlcTask Outputs</Name>
						<Var>
							<Name>GVL_MD200_IO.bRUN_DO</Name>
							<Comment><![CDATA[ Staged logical RUN: ST-2318 Module 10 immediately before AO module.
 DO0 is bit 0 of Output(s)^Byte 0; map ONLY one bit (not entire BYTE).
 WARNING: physical DO0/pin 0 must be confirmed unused and NPN wiring
 checked by the on-site technician BEFORE activating this configuration.
 All runtime software permits remain FALSE by default.]]></Comment>
							<Type>BOOL</Type>
						</Var>
						<Var>
							<Name>GVL_MD200_IO.nAO1_Raw</Name>
							<Comment><![CDATA[ MD200 physical process-image channels, staged for deliberate link review.
 ST-4424 Module 11 Channel AO1 (physical terminal 1, 0-10V).
 UINT 16 bit with 12-bit useful range 0..4095.]]></Comment>
							<Type>UINT</Type>
						</Var>
						<Var>
							<Name>GVL.aOut</Name>
							<Comment><![CDATA[ RxPDO 4 byte]]></Comment>
							<Type GUID="{527C5C5C-1CF8-1963-ACDC-85B7B3E5B586}">ARRAY [0..3] OF BYTE</Type>
						</Var>
					</Vars>
