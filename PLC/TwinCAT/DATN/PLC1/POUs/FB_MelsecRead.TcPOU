<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_MelsecRead" Id="{7ec92241-1e96-4180-aa1c-05ecfc9517e6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MelsecRead
VAR_INPUT
    bExecute    : BOOL;             // Cạnh lên: Bắt đầu giao dịch Read
    eDevice     : E_MelsecDevice;   // Loại vùng nhớ (DEV_M, DEV_D, ...)
    nStartAddr  : UDINT;            // Địa chỉ bắt đầu (M1001 -> 1001, D100 -> 100)
    nPoints     : UINT;             // Số điểm đọc (Số bit hoặc số word)
    bBitAccess  : BOOL;             // TRUE: Đọc Bit (M), FALSE: Đọc Word (D)
    pData       : PVOID;            // Con trỏ tới vùng đệm lưu kết quả đọc
    nDataSize   : UDINT;            // Kích thước vùng đệm đích (bytes)
END_VAR

VAR_IN_OUT
    stSession   : ST_MelsecSession; // Session TCP dùng chung
END_VAR

VAR_OUTPUT
    bBusy       : BOOL;
    bDone       : BOOL;
    bError      : BOOL;
    nErrorID    : UDINT;            // 0=OK, Mã lỗi Beckhoff socket hoặc EndCode Mitsubishi
END_VAR

VAR
    fbTrigger   : R_TRIG;
    fbSend      : FB_SocketSend;
    fbReceive   : FB_SocketReceive;
    tonTimeout  : TON;

    aTx         : ARRAY[0..31] OF BYTE;
    aRx         : ARRAY[0..255] OF BYTE;
    nEndCode    : UINT;

    pDestByte   : POINTER TO BYTE;
    pDestBit    : POINTER TO BOOL;
    nIdx        : UDINT;
    nCopyBytes  : UDINT;

    nState      : INT := 0;
    bOwnsSession : BOOL;
    nRxCount    : UDINT;
    nExpectedFrame : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbTrigger(CLK := bExecute);
// Timer receives a scan on every PLC cycle, even between TCP polls.
tonTimeout(IN := bBusy AND ((nState = 20) OR (nState = 21)), PT := T#5S);

// Xóa cờ trạng thái khi bắt đầu lệnh mới
IF nState = 0 THEN
    IF fbTrigger.Q THEN
        bDone    := FALSE;
        bError   := FALSE;
        nErrorID := 0;
    END_IF;
END_IF;

// Kiểm tra điều kiện tiên quyết
IF fbTrigger.Q THEN
    IF NOT stSession.bConnected THEN
        bError   := TRUE;
        nErrorID := 16#E101; // Socket chưa kết nối
        RETURN;
    ELSIF stSession.bBusy THEN
        bError   := TRUE;
        nErrorID := 16#E102; // Session đang bận
        RETURN;
    ELSIF (pData = 0) OR (nDataSize = 0) THEN
        bError   := TRUE;
        nErrorID := 16#E103; // Vùng đệm đích không hợp lệ
        RETURN;
    ELSIF (nPoints = 0) OR (nStartAddr > 16#FFFFFF)
        OR (bBitAccess AND ((UINT_TO_UDINT(nPoints) > nDataSize) OR (((UINT_TO_UDINT(nPoints) + 1) / 2) > (SIZEOF(aRx) - 11))))
        OR ((NOT bBitAccess) AND (((UINT_TO_UDINT(nPoints) * 2) > nDataSize) OR ((UINT_TO_UDINT(nPoints) * 2) > (SIZEOF(aRx) - 11)))) THEN
        bError := TRUE;
        nErrorID := 16#E106; // Invalid quantity, address or destination length
        RETURN;
    ELSE
        // ============================================================
        // 1. ĐÓNG GÓI KHUNG YÊU CẦU ĐỌC MC PROTOCOL 3E (BINARY READ)
        // Chiều dài cố định: 21 bytes
        // ============================================================
        // 1.1. Subheader: 0x50 0x00
        aTx[0] := 16#50;
        aTx[1] := 16#00;

        // 1.2. Network No: 0x00
        aTx[2] := 16#00;

        // 1.3. PC No: 0xFF
        aTx[3] := 16#FF;

        // 1.4. Target Module I/O: 0xFF 0x03
        aTx[4] := 16#FF;
        aTx[5] := 16#03;

        // 1.5. Target Module Drop: 0x00
        aTx[6] := 16#00;

        // 1.6. Request Data Length: 12 bytes (Từ Timer đến hết Points: 2+2+2+3+1+2 = 12)
        aTx[7] := 16#0C;
        aTx[8] := 16#00;

        // 1.7. Monitoring Timer: 0x10 0x00 (4 giây)
        aTx[9]  := 16#10;
        aTx[10] := 16#00;

        // 1.8. Command: 0x01 0x04 (Batch Read - Đọc hàng loạt)
        aTx[11] := 16#01;
        aTx[12] := 16#04;

        // 1.9. Subcommand: 0x0001 (Bit units) hoặc 0x0000 (Word units)
        IF bBitAccess THEN
            aTx[13] := 16#01;
            aTx[14] := 16#00;
        ELSE
            aTx[13] := 16#00;
            aTx[14] := 16#00;
        END_IF;

        // 1.10. Start Device Address (3 bytes: LSB -> MSB)
        aTx[15] := UDINT_TO_BYTE(nStartAddr AND 16#FF);
        aTx[16] := UDINT_TO_BYTE(SHR(nStartAddr, 8) AND 16#FF);
        aTx[17] := UDINT_TO_BYTE(SHR(nStartAddr, 16) AND 16#FF);

        // 1.11. Device Code (M=0x90, D=0xA8, ...)
        aTx[18] := TO_BYTE(eDevice);

        // 1.12. Number of Device Points (2 bytes: LSB -> MSB)
        aTx[19] := UINT_TO_BYTE(nPoints AND 16#FF);
        aTx[20] := UINT_TO_BYTE(SHR(nPoints, 8) AND 16#FF);

        bBusy  := TRUE;
        bOwnsSession := TRUE;
        nRxCount := 0;
        nExpectedFrame := 0;
        nState := 10;
    END_IF;
END_IF;


// ================================================================
// MÁY TRẠNG THÁI GIAO TIẾP SOCKET
// ================================================================
CASE nState OF

    10: // PHÁT LỆNH GỬI KHUNG REQUEST
        fbSend(
            sSrvNetId := '',
            hSocket   := stSession.hSocket,
            cbLen     := 21,
            pSrc      := ADR(aTx),
            bExecute  := TRUE,
            tTimeout  := T#3S
        );

        nState := 11;


    11: // CHỜ GỬI XONG
        fbSend(
            sSrvNetId := '',
            hSocket   := stSession.hSocket,
            cbLen     := 21,
            pSrc      := ADR(aTx),
            bExecute  := FALSE,
            tTimeout  := T#3S
        );

        IF NOT fbSend.bBusy THEN
            IF fbSend.bError THEN
                bError   := TRUE;
                nErrorID := fbSend.nErrId;
                stSession.bConnected := FALSE;
                bBusy    := FALSE;
                nState   := 0;
            ELSE
                nState := 20;
            END_IF;
        END_IF;


    20: // PHÁT LỆNH NHẬN RESPONSE
        fbReceive(
            sSrvNetId := '',
            hSocket   := stSession.hSocket,
            cbLen     := SIZEOF(aRx) - nRxCount,
            pDest     := ADR(aRx[nRxCount]),
            bExecute  := TRUE,
            tTimeout  := T#3S
        );

        nState := 21;


    21: // CHỜ PLC-Q TRẢ RESPONSE (Polled receive với timeout 2 giây)
        fbReceive(
            sSrvNetId := '',
            hSocket   := stSession.hSocket,
            cbLen     := SIZEOF(aRx) - nRxCount,
            pDest     := ADR(aRx[nRxCount]),
            bExecute  := FALSE,
            tTimeout  := T#3S
        );

        IF NOT fbReceive.bBusy THEN
            IF fbReceive.bError THEN
                bError   := TRUE;
                nErrorID := fbReceive.nErrId;
                stSession.bConnected := FALSE;
                bBusy    := FALSE;
                nState   := 0;

            ELSIF fbReceive.nRecBytes > 0 THEN
                nRxCount := nRxCount + fbReceive.nRecBytes;
                IF nRxCount >= 9 THEN
                    nExpectedFrame := 9 + BYTE_TO_UDINT(aRx[7]) + BYTE_TO_UDINT(aRx[8]) * 256;
                    IF (nExpectedFrame < 11) OR (nExpectedFrame > SIZEOF(aRx)) THEN
                        bError := TRUE; nErrorID := 16#E104;
                        stSession.bConnected := FALSE;
                        bBusy := FALSE; nState := 0;
                    ELSIF nRxCount >= nExpectedFrame THEN
                        IF (aRx[0] <> 16#D0) OR (aRx[1] <> 16#00) THEN
                            bError := TRUE; nErrorID := 16#E105;
                            stSession.bConnected := FALSE;
                        ELSE
                            nEndCode := BYTE_TO_UINT(aRx[9]) + BYTE_TO_UINT(aRx[10]) * 256;
                            IF nEndCode <> 0 THEN
                                bError := TRUE; nErrorID := nEndCode;
                            ELSIF (bBitAccess AND (nExpectedFrame < 11 + ((UINT_TO_UDINT(nPoints) + 1) / 2)))
                                 OR ((NOT bBitAccess) AND (nExpectedFrame < 11 + UINT_TO_UDINT(nPoints) * 2)) THEN
                                bError := TRUE; nErrorID := 16#E107;
                                stSession.bConnected := FALSE;
                            ELSE
                                IF bBitAccess THEN
                                    pDestBit := pData;
                                    FOR nIdx := 0 TO (UINT_TO_UDINT(nPoints) - 1) DO
                                        IF (nIdx MOD 2) = 0 THEN
                                            pDestBit[nIdx] := ((aRx[11 + (nIdx / 2)] AND 16#10) <> 0);
                                        ELSE
                                            pDestBit[nIdx] := ((aRx[11 + (nIdx / 2)] AND 16#01) <> 0);
                                        END_IF;
                                    END_FOR;
                                ELSE
                                    pDestByte := pData;
                                    nCopyBytes := UINT_TO_UDINT(nPoints) * 2;
                                    FOR nIdx := 0 TO (nCopyBytes - 1) DO
                                        pDestByte[nIdx] := aRx[11 + nIdx];
                                    END_FOR;
                                END_IF;
                                bDone := TRUE;
                            END_IF;
                        END_IF;
                        bBusy := FALSE; nState := 0;
                    ELSE
                        nState := 20; // Fragment received; wait for rest of frame
                    END_IF;
                ELSE
                    nState := 20; // Header itself is fragmented
                END_IF;

            ELSIF tonTimeout.Q THEN
                // Quá 2 giây không có phản hồi
                bError   := TRUE;
                nErrorID := 16#E103; // Timeout chờ response
                stSession.bConnected := FALSE;
                bBusy    := FALSE;
                nState   := 0;

            ELSE
                // Chưa có dữ liệu về trong scan này -> Kích đọc tiếp ở scan sau
                nState := 20;
            END_IF;
        END_IF;

END_CASE;

// Cập nhật trạng thái bận vào session dùng chung
// Only the FB that acquired the socket lock may release it.
IF bBusy THEN
    stSession.bBusy := TRUE;
ELSIF bOwnsSession THEN
    stSession.bBusy := FALSE;
    bOwnsSession := FALSE;
END_IF;
]]></ST>
    </Implementation>
    <LineIds Name="FB_MelsecRead">
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>